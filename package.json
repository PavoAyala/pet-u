{
  "name": "pet-u-monorepo",
  "private": true,
  "engines": {
    "node": ">=18.17.1"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm emulators & turbo dev --parallel",
    "build": "turbo build",
    "check": "turbo check",
    "preemulators": "npx kill-port 9099 8080 5001 9000 4000 4400 4500 9150 || true",
    "emulators": "firebase emulators:start --import=.firebase-emulators-data --export-on-exit=.firebase-emulators-data",
    "emulators:export": "firebase emulators:export --force .firebase-emulators-data"
},
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.0.0",
    "turbo": "^2.8.20",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "firebase": "12.10.0",
      "@firebase/app": "^0.13.0",
      "@firebase/auth": "^1.10.0",
      "@firebase/firestore": "^4.8.0",
      "@firebase/database": "^1.0.14",
      "@firebase/functions": "^0.13.0",
      "@firebase/analytics": "^0.10.21",
      "@firebase/storage": "^0.13.6"
    }
  }
}
