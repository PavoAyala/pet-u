{
  "name": "pet-u-monorepo",
  "private": true,
  "engines": {
    "node": ">=18.17.1"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^5.5.7"
    }
  },
  "scripts": {
    "dev": "concurrently \"pnpm emulators\" \"turbo dev\"",
    "build": "turbo build",
    "check": "turbo check",
    "emulators": "mkdir -p ./.firebase-emulators-data && firebase emulators:start --import=./.firebase-emulators-data --export-on-exit=./.firebase-emulators-data",
    "emulators:export": "mkdir -p ./.firebase-emulators-data && firebase emulators:export --force ./.firebase-emulators-data"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.8.20",
    "typescript": "^5.0.0"
  }
}
