---
import Layout from '~/layouts/PageLayout.astro';
import TubelightNavbar from '~/components/TubelightNavbar.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'PET-U Daycare & Hotel',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  
  <Fragment slot="header">
    <TubelightNavbar currentPath="/" />
  </Fragment>

  <!-- SECCIÓN HERO (CUERPO PRINCIPAL) -->
  <section class="relative w-full h-[100dvh] bg-[#fdfbf7] flex items-start md:items-center overflow-hidden pt-32 md:pt-0">
    <div class="w-full max-w-4xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 relative z-10 text-[#3C4F35]">
      
      <!-- CONTENIDO IZQUIERDA (Alineado relativo al centro en desktop) -->
      <div class="flex flex-col justify-start md:justify-center text-left md:col-start-1 mt-10 md:mt-0 xl:ml-20">
        
        <h1 class="text-5xl md:text-6xl font-serif font-bold tracking-tight mb-4 drop-shadow-sm text-[#3C4F35]">
          #JustLike<br/>Home
        </h1>
        <p class="text-xl mb-8 opacity-90 leading-snug font-medium text-gray-600">
          La guardería y hotel boutique donde tu consentido de cuatro patas descansará como en casa.
        </p>
        
        <div class="flex flex-wrap items-center gap-4">
          <a href="#reservar" class="bg-[#3C4F35] shadow-lg hover:bg-[#2A3825] text-white px-8 py-2.5 rounded-full font-bold transition-all duration-200">
            Agendar cita
          </a>
          <a href="#tienda" class="border-2 border-[#3C4F35] hover:bg-[#3C4F35] hover:text-white text-[#3C4F35] px-8 py-2.5 rounded-full font-bold flex items-center gap-2 transition-all duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 opacity-90" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <circle cx="6" cy="19" r="2"></circle>
              <circle cx="17" cy="19" r="2"></circle>
              <path d="M17 17h-11v-14h-2"></path>
              <path d="M6 5l14 1l-1 7h-13"></path>
            </svg>
            Tienda
          </a>
        </div>
      </div>

    </div>

    <!-- IMAGEN DEL PERRO (ESQUINA INFERIOR DERECHA) -->
    <div class="absolute bottom-0 right-[5%] md:right-[15%] w-64 md:w-80 lg:w-96 z-0 mix-blend-normal object-bottom flex justify-end">
        <img 
          src="/images/perrito-hero.png" 
          alt="Perrito feliz PET-U" 
          class="w-full object-contain -mb-1"
          style="filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.1));"
        />
    </div>
  </section>



  <!-- OVERRIDE FOOTER PARA INTEGRAR EL COMPONENTE SOLICITADO (Nativo en Astro) -->
  <Fragment slot="footer">
    <footer class="py-8 md:py-16 bg-[#fdfbf7] relative z-10">
      <div class="mx-auto max-w-5xl px-6">
        <a href="/" aria-label="go home" class="mx-auto block w-fit">
          <img src="/images/logo.png" alt="PET-U Logo" class="h-20 w-auto" />
        </a>

        <div class="my-8 flex flex-wrap justify-center gap-6 text-sm font-medium">
          <a href="#" class="text-gray-500 hover:text-[#3C4F35] block transition duration-150"><span>Historia</span></a>
          <a href="/servicios" class="text-gray-500 hover:text-[#3C4F35] block transition duration-150"><span>Servicios</span></a>
          <a href="#" class="text-gray-500 hover:text-[#3C4F35] block transition duration-150"><span>Instalaciones</span></a>
          <a href="/contacto" class="text-gray-500 hover:text-[#3C4F35] block transition duration-150"><span>Contacto</span></a>
          <a href="#" class="text-gray-500 hover:text-[#3C4F35] block transition duration-150"><span>Tienda</span></a>
        </div>
        
        <div class="my-8 flex flex-wrap justify-center gap-6 text-sm">
          <!-- WhatsApp -->
          <a href="https://wa.me/5211234567890" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-gray-400 hover:text-[#3C4F35] block transition">
            <Icon name="tabler:brand-whatsapp" class="w-6 h-6" />
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/pet.uhotel/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-gray-400 hover:text-[#3C4F35] block transition">
            <Icon name="tabler:brand-instagram" class="w-6 h-6" />
          </a>
          <!-- Facebook -->
          <a href="https://www.facebook.com/profile.php?id=61563445343846" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-gray-400 hover:text-[#3C4F35] block transition">
            <Icon name="tabler:brand-facebook" class="w-6 h-6" />
          </a>
          <!-- Email / Contacto -->
          <a href="mailto:hola@petu.com" aria-label="Enviar Correo" class="text-gray-400 hover:text-[#3C4F35] block transition">
            <Icon name="tabler:mail" class="w-6 h-6" />
          </a>
        </div>
        
        <span class="text-gray-400 block text-center text-sm"> © {new Date().getFullYear()} PET-U Daycare & Hotel, Todos los derechos reservados.</span>
      </div>
    </footer>
  </Fragment>

</Layout>
