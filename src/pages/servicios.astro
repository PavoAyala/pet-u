---
import Layout from '~/layouts/PageLayout.astro';
import TubelightNavbar from '~/components/TubelightNavbar.astro';
import Footer from '~/components/Footer.astro';

const metadata = {
  title: 'Servicios | PET-U Daycare & Hotel',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  
  <Fragment slot="header">
    <TubelightNavbar currentPath="/servicios" />
  </Fragment>

  <!-- SECCIÓN SERVICIOS Y PLANES -->
  <section class="w-full bg-[#f6f5f0] pt-32 pb-24 px-6 min-h-screen relative z-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-serif font-bold text-[#3C4F35] mb-4">Nuestros Servicios y Planes</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">Membresías, hospedaje y transporte diseñados exclusivamente para la comodidad, socialización y felicidad de tu mascota.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Fun Day -->
        <div class="bg-white rounded-3xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100 flex flex-col h-full">
          <h3 class="text-2xl font-serif font-bold text-[#3C4F35] mb-2">Fun Day <span class="text-sm font-sans font-normal text-gray-500 block">Guardería por día</span></h3>
          <p class="text-gray-600 text-sm mb-6 flex-grow">¡Día lleno de juegos y socialización en un ambiente súper seguro!</p>
          <ul class="text-sm text-gray-700 space-y-3 mb-8">
            <li class="flex items-center justify-between border-b border-gray-50 pb-2">
              <span>0 a 30 kg:</span> <strong class="text-[#3C4F35] text-lg">$220 MXN</strong>
            </li>
            <li class="flex items-center justify-between border-b border-gray-50 pb-2">
              <span>30 kg o más:</span> <strong class="text-[#3C4F35] text-lg">$300 MXN</strong>
            </li>
            <li class="pt-2 text-xs text-gray-500">
              🕒 L-V: 8:00 AM - 7:00 PM<br/>🕒 Sáb: 8:00 AM - 4:00 PM
            </li>
          </ul>
          <a href="https://wa.me/528145493733" target="_blank" class="block text-center bg-[#3C4F35] text-white py-3 rounded-full font-semibold hover:bg-[#2A3825] shadow-md hover:shadow-lg transition-all">Agendar Fun Day</a>
        </div>

        <!-- Happy Tails Pass -->
        <div class="bg-white rounded-3xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100 flex flex-col h-full relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-[#f0e6d2] text-[#3C4F35] text-xs font-bold px-3 py-1 rounded-bl-xl">-20% transporte</div>
          <h3 class="text-2xl font-serif font-bold text-[#3C4F35] mb-2 mt-4">Happy Tails Pass</h3>
          <p class="text-gray-600 text-sm mb-6 flex-grow">Diversión y cuidado para tu mascota. Tus días ocupados serán sus mejores días.</p>
          <div class="flex gap-4 text-sm text-gray-700 mb-8 border-t border-gray-100 pt-4 relative z-10">
            <div>
              <strong class="text-[#3C4F35] font-serif block mb-1">Mascota chica</strong>
              <ul class="text-xs space-y-1">
                <li>2 días: <strong>$1,496</strong>/m</li>
                <li>3 días: <strong>$2,244</strong>/m</li>
                <li>5 días: <strong>$3,740</strong>/m</li>
              </ul>
            </div>
            <div>
              <strong class="text-[#3C4F35] font-serif block mb-1">Mascota grande</strong>
              <ul class="text-xs space-y-1">
                <li>2 días: <strong>$2,040</strong>/m</li>
                <li>3 días: <strong>$3,060</strong>/m</li>
                <li>5 días: <strong>$5,100</strong>/m</li>
              </ul>
            </div>
          </div>
          <a href="https://wa.me/528145493733" target="_blank" class="block text-center border-2 border-[#3C4F35] text-[#3C4F35] py-3 rounded-full font-semibold hover:bg-[#3C4F35] hover:text-white transition-all mt-auto relative z-10">Solicitar suscripción</a>
        </div>

        <!-- Pawtastic Days -->
        <div class="bg-[#3C4F35] text-white rounded-3xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.1)] flex flex-col h-full relative overflow-hidden">
          <div class="absolute -right-6 -top-6 text-white/5">
             <svg xmlns="http://www.w3.org/2000/svg" class="w-32 h-32" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path><path d="M12 14l0 7"></path><path d="M10 14l-2 7"></path><path d="M14 14l2 7"></path></svg>
          </div>
          <h3 class="text-2xl font-serif font-bold mb-2 relative z-10 text-[#f0e6d2]">Pawtastic Days</h3>
          <p class="text-white/80 text-sm mb-6 flex-grow relative z-10">L-V Daycare, 4 noches de hotel (t. baja) y 1 baño gratis.</p>
          <ul class="text-sm text-white/90 space-y-4 mb-4 relative z-10">
            <li class="border-b border-white/20 pb-3">
              <strong class="text-[#f0e6d2] font-serif block text-lg">Mascota chica</strong>
              <strong>$5,185 MXN</strong> mensual <br><span class="text-white/60 text-xs text-balance">($4,880 con cargo domiciliado TDC)</span>
            </li>
            <li class="pb-2">
              <strong class="text-[#f0e6d2] font-serif block text-lg">Mascota grande</strong>
              <strong>$6,945 MXN</strong> mensual <br><span class="text-white/60 text-xs text-balance">($6,536 con cargo domiciliado TDC)</span>
            </li>
          </ul>
          <div class="text-[11px] text-white/70 mb-6 bg-white/10 p-3 rounded-xl border border-white/10 relative z-10">-30% en transporte y -20% en servicios extras</div>
          <a href="https://wa.me/528145493733" target="_blank" class="block text-center bg-[#f0e6d2] text-[#3C4F35] py-3 rounded-full font-bold hover:bg-white shadow-md hover:shadow-lg transition-all mt-auto relative z-10">Solicitar Pawtastic Days</a>
        </div>

        <!-- Happy Bus -->
        <div class="bg-white rounded-3xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100 flex flex-col h-full md:col-span-1 lg:col-span-1 border-l-4 border-l-[#d2a265]">
          <h3 class="text-2xl font-serif font-bold text-[#3C4F35] mb-2">Happy Bus</h3>
          <p class="text-gray-600 text-sm mb-6">Transporte para tu mascota. Precios por día (ida y vuelta).</p>
          <ul class="text-sm text-gray-700 space-y-4 mb-6 flex-grow">
            <li class="border-b border-gray-50 pb-3">
               <div class="flex justify-between items-center mb-1"><strong class="text-[#3C4F35] font-serif text-base">Zona A</strong> <strong class="text-[#3C4F35]">$100</strong></div>
               <span class="text-xs text-gray-500 leading-tight block">UDEM, Bosques del Valle, Corregidora.</span>
            </li>
            <li class="border-b border-gray-50 pb-3">
               <div class="flex justify-between items-center mb-1"><strong class="text-[#3C4F35] font-serif text-base">Zona B</strong> <strong class="text-[#3C4F35]">$150</strong></div>
               <span class="text-xs text-gray-500 leading-tight block">Valle Poniente, Huasteca, Santa Catarina Centro.</span>
            </li>
            <li class="border-b border-gray-50 pb-2">
               <div class="flex justify-between items-center mb-1"><strong class="text-[#3C4F35] font-serif text-base">Zona C</strong> <strong class="text-[#3C4F35]">$200</strong></div>
               <span class="text-xs text-gray-500 leading-tight block">San Jerónimo, San Agustín, Loma Larga, Centrito Valle.</span>
            </li>
          </ul>
          
          <!-- Notas Oficiales del Happy Bus -->
          <div class="bg-gray-50 p-4 rounded-2xl border border-gray-100 mt-auto">
            <ul class="text-xs md:text-[14px] text-gray-500 leading-relaxed space-y-2 list-disc pl-4">
              <li>Limitado a las zonas indicadas en el mapa, tanto en estancia regular como en paquetes y membresías.</li>
              <li>En 2 o más mascotas aplica el <strong class="text-gray-700">40% de descuento en la segunda mascota</strong>.</li>
              <li>Los costos se aplican por día (ida y vuelta), no por viaje.</li>
            </ul>
          </div>
        </div>
        
        <!-- Pawflex Days -->
        <div class="bg-gradient-to-br from-[#f8efe0] to-[#e8decb] rounded-3xl p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] flex flex-col md:col-span-1 lg:col-span-2 relative overflow-hidden">
           <svg xmlns="http://www.w3.org/2000/svg" class="absolute -left-10 -bottom-10 w-48 h-48 opacity-10 text-[#3C4F35]" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path></svg>
           
          <div class="relative z-10">
            <h3 class="text-3xl font-serif font-bold text-[#3C4F35] mb-3">Pawflex Days</h3>
            <p class="text-gray-700 max-w-lg mb-6 font-medium">Días de daycare flexibles que puedes usar durante todo el mes el día que sea de tu agrado! Incluye 30% descuento en transporte y 20% en extras.</p>
            
            <div class="grid grid-cols-2 gap-8 text-sm text-gray-800">
              <div>
                <strong class="block text-[#3C4F35] mb-2 font-serif text-lg">Costo mascota chica:</strong>
                <ul class="space-y-2">
                  <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>5 días:</span> <strong class="text-[#3C4F35]">$950</strong></li>
                  <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>10 días:</span> <strong class="text-[#3C4F35]">$1,900</strong></li>
                  <li class="flex justify-between"><span>15 días:</span> <strong class="text-[#3C4F35]">$2,805</strong></li>
                </ul>
              </div>
              <div>
                <strong class="block text-[#3C4F35] mb-2 font-serif text-lg">Costo mascota grande:</strong>
                <ul class="space-y-2">
                  <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>5 días:</span> <strong class="text-[#3C4F35]">$1,275</strong></li>
                  <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>10 días:</span> <strong class="text-[#3C4F35]">$2,550</strong></li>
                  <li class="flex justify-between"><span>15 días:</span> <strong class="text-[#3C4F35]">$3,825</strong></li>
                </ul>
              </div>
            </div>
            
            <div class="mt-8">
              <a href="https://wa.me/528145493733" target="_blank" class="inline-block bg-[#3C4F35] text-white py-3 px-8 rounded-full font-bold hover:bg-[#2A3825] shadow-md hover:shadow-lg transition-all">Cotizar mis días</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SECCIÓN HOTEL JUST LIKE HOME -->
  <section class="w-full bg-[#3C4F35] py-24 px-6 text-white relative z-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-[#f0e6d2] mb-4">Hotel Just Like Home</h2>
        <p class="text-lg text-white/80 max-w-2xl mx-auto">La misión de nuestro hotel es brindar amor, diversión, atención y tranquilidad a tu peludo para que esperen felizmente tu regreso.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Precios -->
        <div class="bg-white/5 rounded-3xl p-8 border border-white/10 lg:col-span-2">
          <h3 class="text-2xl font-serif font-bold text-[#f0e6d2] mb-6 border-b border-white/10 pb-4">Precios por noche</h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-white/60 text-sm uppercase tracking-wider border-b border-white/10">
                  <th class="pb-3 font-medium">Tamaño (Peso)</th>
                  <th class="pb-3 font-medium">Temporada Baja</th>
                  <th class="pb-3 font-medium">Temporada Alta</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10">
                <tr>
                  <td class="py-4 font-medium">Mascota chica <span class="text-xs text-white/50 block">0 a 15 kg</span></td>
                  <td class="py-4 font-bold text-[#f0e6d2]">$280 MXN</td>
                  <td class="py-4 font-bold text-[#f0e6d2]">$380 MXN</td>
                </tr>
                <tr>
                  <td class="py-4 font-medium">Mascota mediana <span class="text-xs text-white/50 block">15 a 25 kg</span></td>
                  <td class="py-4 font-bold text-[#f0e6d2]">$350 MXN</td>
                  <td class="py-4 font-bold text-[#f0e6d2]">$450 MXN</td>
                </tr>
                <tr>
                  <td class="py-4 font-medium">Mascota grande <span class="text-xs text-white/50 block">25 a 50 kg</span></td>
                  <td class="py-4 font-bold text-[#f0e6d2]">$430 MXN</td>
                  <td class="py-4 font-bold text-[#f0e6d2]">$500 MXN</td>
                </tr>
                <tr>
                  <td class="py-4 font-medium">Mascota XL <span class="text-xs text-white/50 block">50 kg o más</span></td>
                  <td class="py-4 font-bold text-[#f0e6d2]">$520 MXN</td>
                  <td class="py-4 font-bold text-[#f0e6d2]">$620 MXN</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Check-in e Info -->
        <div class="flex flex-col gap-6">
          <div class="bg-[#f0e6d2] text-[#3C4F35] rounded-3xl p-8 shadow-lg">
            <h3 class="text-xl font-serif font-bold mb-4 border-b border-[#3C4F35]/20 pb-3">Horarios de Hotel</h3>
            <ul class="space-y-4 mb-4 font-medium text-sm">
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" /></svg>
                <span><strong>Check-in:</strong> 11:00 AM a 7:00 PM</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                <span><strong>Check-out:</strong> 10:00 AM a 2:00 PM</span>
              </li>
            </ul>
            <p class="text-xs bg-white/50 p-3 rounded-lg border border-[#3C4F35]/10"><strong>* Nota: Costo adicional de $100 MXN por incumplimiento de horarios.</strong></p>
          </div>
          
          <div class="bg-white/5 rounded-3xl p-6 border border-white/10 flex-grow">
             <h3 class="text-lg font-serif font-bold text-[#f0e6d2] mb-3">Requisitos de Ingreso</h3>
             <ul class="text-sm space-y-2 list-disc pl-4 text-white/80">
               <li>Cartilla de vacunación al corriente (Séxtuple, Giardia, Bordatella, Rabia).</li>
               <li>Protección Bravecto vigente.</li>
               <li>Desparasitación interna.</li>
               <li>Traer collar, platos y comida suficiente.</li>
               <li>Prenda con olor al dueño. (Cama y cobija sugeridas)</li>
             </ul>
          </div>
        </div>
      </div>
      
      <p class="text-center text-sm text-white/90 mt-10"><strong>Nota: Estancias de 6 noches o más se agregará un baño obligatorio con costo.</strong></p>
    </div>
  </section>

  <!-- SECCIÓN GROOMING & ADIESTRAMIENTO -->
  <section class="w-full bg-[#f6f5f0] py-24 px-6 relative z-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-[#3C4F35] mb-4">Grooming & Extras</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">Mantén a tu mascota radiante y saludable con nuestros servicios complementarios de estética y protección.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Spa -->
        <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm">
          <h3 class="text-xl font-serif font-bold text-[#3C4F35] mb-6 flex items-center gap-2">
            <svg class="w-6 h-6" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 4a3 3 0 0 1 3 3v1a3 3 0 0 1 -3 3h-2v1h5.88l-1.47 5.09a2.98 2.98 0 0 1 -2.76 2.01h-3.3a2.98 2.98 0 0 1 -2.76 -2.01l-1.47 -5.09h5.88v-4z"></path></svg>
            Grooming & Spa
          </h3>
          <ul class="text-sm text-gray-700 space-y-3">
             <li class="flex justify-between border-b border-gray-50 pb-2"><span>Raza chica</span> <strong class="text-[#3C4F35]">$150 / $200</strong></li>
             <li class="flex justify-between border-b border-gray-50 pb-2"><span>Raza mediana</span> <strong class="text-[#3C4F35]">$250 / $350</strong></li>
             <li class="flex justify-between border-b border-gray-50 pb-2"><span>Raza grande</span> <strong class="text-[#3C4F35]">$400 / $450</strong></li>
             <li class="flex justify-between text-xs pt-1 border-b border-gray-50 pb-2 text-gray-500">*(Precios de pelo corto / pelo largo)*</li>
             <li class="flex justify-between border-b border-gray-50 pb-2 pt-2"><span>Corte de uñas / Higiénico</span> <strong class="text-[#3C4F35]">$100 c/u</strong></li>
             <li class="flex justify-between border-b border-gray-50 pb-2"><span>Lavado dental / Deslanado</span> <strong class="text-[#3C4F35]">$100 c/u</strong></li>
             <li class="flex justify-between pt-1"><span>Corte de pelo</span> <strong class="text-[#3C4F35]">desde $100</strong></li>
          </ul>
        </div>

        <!-- Adiestramiento -->
        <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm">
          <h3 class="text-xl font-serif font-bold text-[#3C4F35] mb-6 flex items-center gap-2">
            <svg class="w-6 h-6" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="6" r="3"></circle><circle cx="18" cy="18" r="3"></circle><line x1="8.7" y1="10.7" x2="15.3" y2="7.3"></line><line x1="8.7" y1="13.3" x2="15.3" y2="16.7"></line></svg>
            Adiestramiento
          </h3>
          <p class="text-sm text-gray-500 mb-6">Módulos de 3 clases para fortalecer el vínculo y buen comportamiento.</p>
          <ul class="text-sm text-gray-700 space-y-4">
            <li class="flex flex-col border-b border-gray-50 pb-4">
              <span class="font-bold text-[#3C4F35] mb-1 font-serif text-lg">Básico o en Casa</span>
              <span><strong>$3,500 MXN</strong> por módulo</span>
            </li>
            <li class="flex flex-col pt-1">
              <span class="font-bold text-[#3C4F35] mb-1 font-serif text-lg">Avanzado</span>
              <span><strong>$4,000 MXN</strong> por módulo</span>
            </li>
          </ul>
        </div>
        
        <!-- Bravecto & Vacunas -->
        <div class="bg-[#f0e6d2] text-[#3C4F35] rounded-3xl p-8 shadow-md">
          <h3 class="text-xl font-serif font-bold mb-6 flex items-center gap-2 border-b border-[#3C4F35]/20 pb-4">
            <svg class="w-6 h-6" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18"></path><line x1="13" y1="8" x2="15" y2="8"></line><line x1="13" y1="12" x2="15" y2="12"></line></svg>
            Vacunas & Bravecto
          </h3>
          <div class="space-y-4 text-sm font-medium">
            <div class="bg-white/40 p-4 rounded-2xl">
              <span class="block font-bold mb-3 uppercase text-[10px] tracking-widest opacity-80">Vacunas</span>
              <ul class="space-y-2">
                 <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>Séxtuple / Bordatella / Rabia</span> <strong>$350 c/u</strong></li>
                 <li class="flex justify-between"><span>Giardia</span> <strong>$430</strong></li>
              </ul>
            </div>
            <div class="bg-white/40 p-4 rounded-2xl">
              <span class="block font-bold mb-3 uppercase text-[10px] tracking-widest opacity-80">Bravecto</span>
              <ul class="space-y-2 text-xs">
                 <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>112.5mg (2-4.5kg)</span> <strong>$730</strong></li>
                 <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>250mg (4.5-10kg)</span> <strong>$770</strong></li>
                 <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>500mg (10-20kg)</span> <strong>$800</strong></li>
                 <li class="flex justify-between border-b border-[#3C4F35]/10 pb-1"><span>1000mg (20-40kg)</span> <strong>$850</strong></li>
