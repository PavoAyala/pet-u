---
import { Icon } from 'astro-icon/components';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { name: 'Inicio', url: '/', icon: 'tabler:home' },
  { name: 'Historia', url: '/historia', icon: 'tabler:book' },
  { name: 'Servicios', url: '/servicios', icon: 'tabler:paw' },
  { name: 'Instalaciones', url: '/instalaciones', icon: 'tabler:building' },
  { name: 'Contacto', url: '/contacto', icon: 'tabler:phone' },
  { name: 'Tienda', url: '/tienda', icon: 'tabler:shopping-bag' }
];
---

<!-- Navbar Flotante (Píldora Tubelight) -->
<div class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-50 w-[95%] sm:w-auto px-0 flex justify-center mt-0">
  <div class="flex items-center justify-between sm:justify-center w-full sm:w-auto gap-1 sm:gap-3 bg-[#fdfbf7]/90 sm:bg-[#fdfbf7]/80 border border-[#f0e6d2] backdrop-blur-md py-1 px-2 sm:px-1 rounded-full shadow-xl shadow-[#3C4F35]/10">
    {navItems.map((item) => {
      // Activo si es exacto la ruta, o si empieza con la ruta (para subpáginas) excepto inicio
      const isActive = currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url));
      
      return (
        <a 
          href={item.url} 
          class={`relative flex items-center justify-center cursor-pointer px-4 xs:px-5 sm:px-6 py-2.5 sm:py-2 rounded-full transition-all duration-300 ${
            isActive ? "text-[#3C4F35]" : "text-gray-400 hover:text-[#3C4F35] hover:bg-[#f0e6d2]/30"
          }`}
          aria-label={item.name}
          title={item.name}
        >
          <!-- Vista Mobile: Icono de Tabler -->
          <Icon name={item.icon} class="w-6 h-6 sm:hidden" />
          
          <!-- Vista Desktop: Texto -->
          <span class="hidden sm:inline text-sm font-semibold">{item.name}</span>
          
          {isActive && (
            <div transition:name="tubelight" class="absolute inset-0 w-full bg-[#f0e6d2]/70 rounded-full -z-10">
              <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-6 sm:w-8 h-1 bg-[#3C4F35] rounded-t-full">
                <div class="absolute w-8 sm:w-12 h-6 bg-[#3C4F35]/20 rounded-full blur-md -top-2 -left-2" />
                <div class="absolute w-6 sm:w-8 h-6 bg-[#3C4F35]/20 rounded-full blur-md -top-1" />
                <div class="absolute w-4 h-4 bg-[#3C4F35]/20 rounded-full blur-sm top-0 left-2" />
              </div>
            </div>
          )}
        </a>
      )
    })}
  </div>
</div>

<!-- Logo Flotante a la izquierda para no perder identidad -->
<div class="fixed top-6 sm:top-8 left-6 z-50 hidden md:block">
  <a href="/" class="hover:opacity-90 transition inline-block">
    <img src="/images/logo.png" alt="PET-U Logo" class="h-12 w-auto drop-shadow-sm" />
  </a>
</div>
