---
export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { name: 'Inicio', url: '/' },
  { name: 'Historia', url: '/historia' },
  { name: 'Servicios', url: '/servicios' },
  { name: 'Instalaciones', url: '/instalaciones' },
  { name: 'Contacto', url: '/contacto' },
  { name: 'Tienda', url: '/tienda' }
];
---

<!-- Navbar Flotante (Píldora Tubelight) -->
  <div class="fixed top-0 sm:top-6 left-1/2 -translate-x-1/2 z-50 w-full sm:w-auto px-4 sm:px-0 flex justify-center mt-4 sm:mt-0">
    <div class="flex items-center gap-1 sm:gap-3 bg-[#fdfbf7]/80 border border-[#f0e6d2] backdrop-blur-md py-1 px-1 rounded-full shadow-xl shadow-[#3C4F35]/5">
      {navItems.map((item) => {
        const isActive = currentPath === item.url;
        
        return (
          <a 
            href={item.url} 
            class={`relative cursor-pointer text-xs sm:text-sm font-semibold px-4 sm:px-6 py-2 rounded-full transition-colors ${
              isActive ? "text-[#3C4F35]" : "text-gray-500 hover:text-[#3C4F35]"
            }`}
          >
            <span>{item.name}</span>
            
            {isActive && (
              <div class="absolute inset-0 w-full bg-[#f0e6d2]/70 rounded-full -z-10">
                <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-8 h-1 bg-[#3C4F35] rounded-t-full">
                  <div class="absolute w-12 h-6 bg-[#3C4F35]/20 rounded-full blur-md -top-2 -left-2" />
                  <div class="absolute w-8 h-6 bg-[#3C4F35]/20 rounded-full blur-md -top-1" />
                  <div class="absolute w-4 h-4 bg-[#3C4F35]/20 rounded-full blur-sm top-0 left-2" />
                </div>
              </div>
            )}
          </a>
        )
      })}
    </div>
  </div>

  <!-- Logo Flotante a la izquierda para no perder identidad -->
  <div class="fixed top-6 sm:top-8 left-6 z-50 hidden md:block">
    <a href="/" class="hover:opacity-90 transition inline-block">
      <img src="/images/logo.png" alt="PET-U Logo" class="h-12 w-auto drop-shadow-sm" />
    </a>
  </div>

