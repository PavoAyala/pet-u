rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección de productos
    match /productos/{productId} {
      // Cualquier persona puede ver el catálogo de productos
      allow read: if true;
      
      // Solo usuarios autenticados (administradores) pueden gestionar el inventario
      allow write: if request.auth != null;
    }

    // Denegar por defecto cualquier otro acceso para mejorar la seguridad
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
