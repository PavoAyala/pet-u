---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
}

const { title = 'Pet-U Admin' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Pet-U Admin</title>
    <meta name="description" content="Panel de administración de Pet-U" />
    <link rel="icon" type="image/png" href="/images/logo_circular.png" />
    <link rel="apple-touch-icon" href="/images/logo_circular.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen text-[#2D3B28]">
    <div class="flex min-h-screen">
      <Sidebar />

      <!-- Main content -->
      <main class="flex-1 flex flex-col overflow-hidden bg-[#fdfbf7]">
        <div class="flex-1 overflow-auto">
          <slot />
        </div>
      </main>
    </div>

    <script>
      import { auth, onAuthStateChanged, signOut } from '@pet-u/firebase-config';

      // Route guard: Redirect to /login if unauthenticated
      onAuthStateChanged(auth, (user) => {
        if (!user) {
          window.location.href = '/login';
        } else {
          // If we're on login page but authenticated, go to dashboard
          if (window.location.pathname === '/login') {
            window.location.href = '/';
          }
          // Highlight active nav
          const activePath = window.location.pathname;
          if (activePath === '/') document.getElementById('nav-dashboard')?.classList.add('bg-white/10', 'text-white');
          if (activePath.includes('/productos')) document.getElementById('nav-products')?.classList.add('bg-white/10', 'text-white');
          if (activePath === '/reservas' || activePath.includes('/reservas/historial')) document.getElementById('nav-reservas')?.classList.add('bg-white/10', 'text-white');
          if (activePath.includes('/reservas/ruta')) document.getElementById('nav-route')?.classList.add('bg-white/10', 'text-white');
        }
      });

      // Handle logout
      const logoutBtn = document.getElementById('logout-btn');
      if (logoutBtn) {
        logoutBtn.onclick = async () => {
          if (confirm('¿Deseas cerrar tu sesión administrativa?')) {
            await signOut(auth);
            window.location.href = '/login';
          }
        };
      }
    </script>
  </body>
</html>
