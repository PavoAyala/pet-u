---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard de Control">
  <div class="px-10 py-12 max-w-[1400px] mx-auto">
    <!-- Bienvenida -->
    <div class="mb-12">
      <h1 class="text-4xl font-serif font-bold text-[#3C4F35]">¡Hola Administrador!</h1>
      <p class="text-gray-400 mt-2 font-medium italic text-lg">Bienvenido al corazón de PET-U. Aquí es donde sucede la magia boutique.</p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <!-- Producto 1 -->
      <div class="bg-white rounded-[32px] p-6 border border-[#3C4F35]/10 shadow-xl shadow-[#3C4F35]/5 group hover:border-[#3C4F35]/30 transition-all">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-[#3C4F35]/5 flex items-center justify-center text-[#3C4F35]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
          </div>
          <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest px-2 py-1 bg-gray-50 rounded-full border border-gray-100">Tienda</span>
        </div>
        <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-1">Total Catálogo</p>
        <p id="total-products" class="text-4xl font-serif font-bold text-[#3C4F35]">...</p>
      </div>

      <!-- Producto 2 -->
      <div class="bg-white rounded-[32px] p-6 border border-[#3C4F35]/10 shadow-xl shadow-[#3C4F35]/5 group hover:border-[#3C4F35]/30 transition-all">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest px-2 py-1 bg-gray-50 rounded-full border border-gray-100">Tienda</span>
        </div>
        <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-1">Stock Positivo</p>
        <p id="in-stock" class="text-4xl font-serif font-bold text-emerald-600">...</p>
      </div>

      <!-- Reserva 1 -->
      <div class="bg-white rounded-[32px] p-6 border border-[#3C4F35]/10 shadow-xl shadow-[#3C4F35]/5 group hover:border-amber-500/30 transition-all">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
          <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest px-2 py-1 bg-gray-50 rounded-full border border-gray-100">Hotel</span>
        </div>
        <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-1">Nuevas Cotizaciones</p>
        <p id="total-reservas" class="text-4xl font-serif font-bold text-amber-500">...</p>
      </div>
      
      <!-- Reserva 2 -->
      <div class="bg-white rounded-[32px] p-6 border border-[#3C4F35]/10 shadow-xl shadow-[#3C4F35]/5 group hover:border-blue-500/30 transition-all">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
          </div>
          <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest px-2 py-1 bg-gray-50 rounded-full border border-gray-100">Hotel</span>
        </div>
        <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-1">Mascotas en Casa</p>
        <p id="active-reservas" class="text-4xl font-serif font-bold text-blue-500">...</p>
      </div>
    </div>

    <!-- Quick Actions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Action: Tienda -->
      <div class="bg-[#3C4F35] rounded-[40px] p-10 relative overflow-hidden shadow-2xl shadow-[#3C4F35]/20 flex flex-col justify-between items-start min-h-[250px] group">
        <div class="relative z-10">
          <h2 class="text-2xl font-serif font-bold text-white mb-3">Administra Existencias</h2>
          <p class="text-white/70 text-sm max-w-[280px] font-medium leading-relaxed">Mantén el inventario actualizado y gestiona las ventas de tus sucursales.</p>
        </div>
        <a href="/productos" class="relative z-10 mt-8 flex items-center gap-3 bg-white text-[#3C4F35] px-8 py-4 rounded-full font-bold hover:bg-[#fdfbf7] transition-all shadow-xl shadow-black/10">
          Módulo de Tienda
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
        <div class="absolute -right-20 -bottom-20 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
      </div>

      <!-- Action: Reservas -->
      <div class="bg-[#f0e6d2] rounded-[40px] p-10 relative overflow-hidden shadow-2xl shadow-[#f0e6d2]/30 flex flex-col justify-between items-start min-h-[250px] group">
        <div class="relative z-10 text-[#3C4F35]">
          <h2 class="text-2xl font-serif font-bold mb-3">Panel de Reservas</h2>
          <p class="text-[#3C4F35]/70 text-sm max-w-[280px] font-medium leading-relaxed">Monitorea en tiempo real cotizaciones (RTDB), pagos y huéspedes del hotel.</p>
        </div>
        <a href="/reservas" class="relative z-10 mt-8 flex items-center gap-3 bg-[#3C4F35] text-white px-8 py-4 rounded-full font-bold hover:bg-[#2b3a26] transition-all shadow-xl shadow-[#3C4F35]/20">
          Motor de Reservas
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
        <div class="absolute -right-20 -top-20 w-64 h-64 bg-[#3C4F35]/5 rounded-full blur-3xl"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { db, collection, getDocs, type DocumentData } from '@pet-u/firebase-config';
  import { getRtdb, ref, onValue } from '@pet-u/firebase-config';

  // Stats Firestore (Tienda)
  const snap = await getDocs(collection(db, 'productos'));
  const products = snap.docs.map((d: DocumentData) => d.data());
  document.getElementById('total-products')!.textContent = String(products.length);
  document.getElementById('in-stock')!.textContent = String(products.filter((p: any) => (p.stock || 0) > 0 || p.nombre).length);

  // Stats RTDB (Reservas)
  const rtdb = getRtdb();
  const reservationsRef = ref(rtdb, 'reservations');
  onValue(reservationsRef, (snapshot) => {
    if (snapshot.exists()) {
      const data = snapshot.val();
      const arr = Object.values(data) as any[];
      const pendingCount = arr.filter(r => r.status === 'pending').length;
      const activeCount = arr.filter(r => r.status === 'active').length;
      document.getElementById('total-reservas')!.textContent = String(pendingCount);
      document.getElementById('active-reservas')!.textContent = String(activeCount);
    } else {
      document.getElementById('total-reservas')!.textContent = '0';
      document.getElementById('active-reservas')!.textContent = '0';
    }
  });
</script>
