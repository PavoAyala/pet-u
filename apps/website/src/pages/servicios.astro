---
import Layout from '~/layouts/PageLayout.astro';
import TubelightNavbar from '~/components/TubelightNavbar.astro';
import Footer from '~/components/Footer.astro';
import ServiceCardModal from '~/components/ServiceCardModal.astro';

const metadata = {
  title: 'Servicios Mágicos | PET-U Daycare & Hotel',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  
  <Fragment slot="header">
    <TubelightNavbar currentPath="/servicios" />
  </Fragment>

  <!-- BACKGROUND MÍSTICO -->
  <section class="w-full bg-[#f6f5f0] min-h-screen relative z-20 pb-32 overflow-hidden selection:bg-[#d2a265] selection:text-[#3C4F35]">
    
    <!-- Elementos Decorativos de Fondo (Estrellas CSS) -->
    <div class="absolute inset-0 z-0 pointer-events-none opacity-20" style="background-image: radial-gradient(circle at 20% 30%, #3C4F35 1px, transparent 1px), radial-gradient(circle at 80% 60%, #3C4F35 1px, transparent 1px); background-size: 100px 100px;"></div>
    

    <!-- Contenido Principal -->
    <div class="max-w-6xl mx-auto px-6 relative z-10 pt-32">
      <!-- HEADER MÍSTICO -->
      <div class="text-center mb-20 relative">
        <div class="flex justify-center items-center gap-4 mb-4 opacity-70 text-[#d2a265]">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
          <span class="tracking-widest uppercase text-sm font-bold text-[#3C4F35]">Los Caminos de PET-U</span>
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
        </div>
        <h1 class="text-5xl md:text-6xl font-serif font-black text-[#3C4F35] mb-6 tracking-tight leading-tight">Servicios & <span class="italic font-light opacity-80">Planes</span></h1>
        <p class="text-lg md:text-xl text-[#3C4F35]/70 max-w-2xl mx-auto font-sans leading-relaxed">Te invitamos a descubrir el destino ideal para la comodidad, socialización y descanso de tu fiel compañero. Elige tu carta.</p>
      </div>
      
      <!-- GRID DE TARJETAS TIPO TAROT -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 x-gap-12 lg:gap-14 perspective-1000 items-start justify-center">

        <!-- 1. FUN DAY -->
        <ServiceCardModal 
          id="funday" 
          title="Fun Day" 
          subtitle="El Sol - Guardería de 1 Día"
          colorTheme="light"
          imgSrc="/images/tarot/fun_day.png"
        >
          
          <Fragment slot="content">
            <h3 class="text-2xl font-serif font-bold text-[#3C4F35] mb-6">Guardería por Día (Fun Day)</h3>
            <p class="text-gray-600 mb-8 text-lg">¡Día lleno de juegos y socialización en un ambiente súper seguro! Es la forma ideal para que tu perrhijo queme energía en un entorno controlado y amoroso.</p>
            
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 mb-8">
              <ul class="text-lg text-gray-700 space-y-4">
                <li class="flex items-center justify-between border-b border-gray-200 pb-4">
                  <span>Razas Pequeñas y Medianas <strong>(0 a 30 kg):</strong></span> 
                  <span class="text-[#3C4F35] text-2xl font-serif font-bold">$220 <span class="text-sm font-sans mxn">MXN</span></span>
                </li>
                <li class="flex items-center justify-between pb-2">
                  <span>Razas Grandes <strong>(30 kg o más):</strong></span> 
                  <span class="text-[#3C4F35] text-2xl font-serif font-bold">$300 <span class="text-sm font-sans mxn">MXN</span></span>
                </li>
              </ul>
            </div>

            <div class="flex items-start gap-4 p-4 border border-[#d2a265]/40 bg-[#d2a265]/10 rounded-xl mb-6">
               <svg class="w-8 h-8 flex-shrink-0 text-[#d2a265] mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
               <div>
                  <strong class="block font-serif text-[#3C4F35] text-lg mb-1">Horarios de Operación</strong>
                  <p class="text-gray-600">Lunes a Viernes: <strong class="text-gray-800">8:00 AM - 7:00 PM</strong></p>
                  <p class="text-gray-600">Sábados: <strong class="text-gray-800">8:00 AM - 4:00 PM</strong></p>
               </div>
            </div>
          </Fragment>
        </ServiceCardModal>

        <!-- 2. MEMBRESÍAS (THE EMPEROR) -->
        <ServiceCardModal 
          id="memberships" 
          title="Membresías" 
          subtitle="El Emperador - Pases Exclusivos"
          colorTheme="gold"
          imgSrc="/images/tarot/memberships.png"
        >
          
          <Fragment slot="content">
            <h3 class="text-3xl font-serif font-bold text-[#3C4F35] mb-2">Planes Mensuales (Membresías)</h3>
            <p class="text-gray-600 mb-8">Diversión, cuidado diario y beneficios exclusivos. Tus días ocupados serán sus mejores días de aventuras.</p>
            
            <div class="space-y-8">
              <!-- Happy Tails Pass -->
              <div class="bg-white border rounded-2xl p-6 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-[#3C4F35] text-white px-4 py-1 rounded-bl-xl text-xs font-bold">-20% Transporte</div>
                <h4 class="font-serif text-2xl font-bold text-[#3C4F35] mb-4">Happy Tails Pass</h4>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <strong class="text-gray-800 border-b pb-1 mb-2 block font-serif">Mascota Chica</strong>
                    <ul class="text-sm space-y-2">
                      <li>2 días: <strong class="text-[#3C4F35] text-base">$1,496</strong>/m</li>
                      <li>3 días: <strong class="text-[#3C4F35] text-base">$2,244</strong>/m</li>
                      <li>5 días: <strong class="text-[#3C4F35] text-base">$3,740</strong>/m</li>
                    </ul>
                  </div>
                  <div>
                    <strong class="text-gray-800 border-b pb-1 mb-2 block font-serif">Mascota Grande</strong>
                    <ul class="text-sm space-y-2">
                      <li>2 días: <strong class="text-[#3C4F35] text-base">$2,040</strong>/m</li>
                      <li>3 días: <strong class="text-[#3C4F35] text-base">$3,060</strong>/m</li>
                      <li>5 días: <strong class="text-[#3C4F35] text-base">$5,100</strong>/m</li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Pawtastic Days -->
              <div class="bg-[#3C4F35] border border-[#3C4F35] rounded-2xl p-6 text-[#f0e6d2] shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-[#d2a265] text-[#3C4F35] px-4 py-1 rounded-bl-xl text-xs font-bold text-wrap w-24 text-center">-30% t. / -20% extras</div>
                <h4 class="font-serif text-2xl font-bold text-[#f0e6d2] mb-1">Pawtastic Days</h4>
                <p class="text-sm opacity-80 mb-4">Daycare (L-V), 4 noches hotel (baja) y 1 baño gratis.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                   <div class="border border-white/10 p-3 rounded-xl bg-white/5">
                      <strong class="block font-serif mb-1">M. Chica</strong>
                      <span class="block text-xl font-bold mb-1">$5,185 MXN</span>
                      <span class="text-[10px] opacity-70 block leading-tight">($4,880 c/ TDC dom.)</span>
                   </div>
                   <div class="border border-white/10 p-3 rounded-xl bg-white/5">
                      <strong class="block font-serif mb-1">M. Grande</strong>
                      <span class="block text-xl font-bold mb-1">$6,945 MXN</span>
                      <span class="text-[10px] opacity-70 block leading-tight">($6,536 c/ TDC dom.)</span>
                   </div>
                </div>
              </div>

               <!-- Pawflex Days -->
               <div class="bg-gradient-to-r from-gray-50 to-beige border rounded-2xl p-6 shadow-sm">
                 <h4 class="font-serif text-2xl font-bold text-[#3C4F35] mb-2">Pawflex Days</h4>
                 <p class="text-sm text-gray-600 mb-4">Días flexibles (úsales cuando quieras) + Descuentos Ext.</p>
                 <div class="grid grid-cols-2 gap-4">
                   <div>
                     <strong class="text-gray-800 border-b pb-1 mb-2 block font-serif text-sm">Chica</strong>
                     <ul class="text-sm space-y-1">
                       <li class="flex justify-between"><span>5d:</span> <strong>$950</strong></li>
                       <li class="flex justify-between"><span>10d:</span> <strong>$1,900</strong></li>
                       <li class="flex justify-between"><span>15d:</span> <strong>$2,805</strong></li>
                     </ul>
                   </div>
                   <div>
                     <strong class="text-gray-800 border-b pb-1 mb-2 block font-serif text-sm">Grande</strong>
                     <ul class="text-sm space-y-1">
                       <li class="flex justify-between"><span>5d:</span> <strong>$1,275</strong></li>
                       <li class="flex justify-between"><span>10d:</span> <strong>$2,550</strong></li>
                       <li class="flex justify-between"><span>15d:</span> <strong>$3,825</strong></li>
                     </ul>
                   </div>
                 </div>
               </div>

            </div>
          </Fragment>
        </ServiceCardModal>

        <!-- 3. HAPPY BUS -->
        <ServiceCardModal 
          id="happybus" 
          title="Happy Bus" 
          subtitle="El Carro - Transporte"
          colorTheme="dark"
          imgSrc="/images/tarot/happy_bus.png"
        >
          
          <Fragment slot="content">
            <h3 class="text-3xl font-serif font-bold text-[#3C4F35] mb-2">Transporte Happy Bus</h3>
            <p class="text-gray-600 mb-8">Nos encargamos de que el viaje sea seguro y lleno de comodidad. Precios cotizados por día (ida y vuelta).</p>
            
            <ul class="text-base text-gray-700 space-y-6 mb-8 bg-gray-50 border border-gray-100 rounded-2xl p-6">
              <li class="border-b border-gray-200 pb-4">
                 <div class="flex justify-between items-center mb-2">
                    <strong class="text-[#3C4F35] font-serif text-xl border-b-2 border-[#d2a265] pb-1">Zona A</strong> 
                    <strong class="text-[#3C4F35] text-2xl font-serif">$100</strong>
                 </div>
                 <span class="text-sm text-gray-500 block relative pl-4"><span class="absolute left-0 top-1.5 w-1.5 h-1.5 rounded-full bg-[#3C4F35]"></span> UDEM, Bosques del Valle, Corregidora.</span>
              </li>
              <li class="border-b border-gray-200 pb-4">
                 <div class="flex justify-between items-center mb-2">
                    <strong class="text-[#3C4F35] font-serif text-xl border-b-2 border-[#d2a265] pb-1">Zona B</strong> 
                    <strong class="text-[#3C4F35] text-2xl font-serif">$150</strong>
                 </div>
                 <span class="text-sm text-gray-500 block relative pl-4"><span class="absolute left-0 top-1.5 w-1.5 h-1.5 rounded-full bg-[#3C4F35]"></span> Valle Poniente, Huasteca, Santa Catarina Centro.</span>
              </li>
              <li>
                 <div class="flex justify-between items-center mb-2">
                    <strong class="text-[#3C4F35] font-serif text-xl border-b-2 border-[#d2a265] pb-1">Zona C</strong> 
                    <strong class="text-[#3C4F35] text-2xl font-serif">$200</strong>
                 </div>
                 <span class="text-sm text-gray-500 block relative pl-4"><span class="absolute left-0 top-1.5 w-1.5 h-1.5 rounded-full bg-[#3C4F35]"></span> San Jerónimo, San Agustín, Loma Larga, Centrito Valle.</span>
              </li>
            </ul>
            
            <div class="p-5 border-l-4 border-[#d2a265] bg-gray-50">
               <ul class="text-sm text-gray-600 space-y-2 list-disc pl-4 font-medium">
                  <li>En 2 o más mascotas aplica el <strong>40% de descuento en la segunda mascota</strong>.</li>
                  <li>Limitado a las zonas indicadas (estancia, paquetes y membresías).</li>
               </ul>
            </div>
          </Fragment>
        </ServiceCardModal>

        <!-- 4. HOTEL -->
        <ServiceCardModal 
          id="hotel" 
          title="Hotel HOGAR" 
          subtitle="La Luna - Estancias Nocturnas"
          colorTheme="dark"
          imgSrc="/images/tarot/hotel.png"
        >
          
          <Fragment slot="content">
            <h3 class="text-3xl font-serif font-bold text-[#3C4F35] mb-2">Hotel Just Like Home</h3>
            <p class="text-gray-600 mb-8">La misión de nuestro hotel es brindar amor y tranquilidad para que esperen felizmente tu regreso.</p>
            
            <div class="overflow-hidden rounded-2xl border border-gray-200 mb-8 shadow-sm">
               <table class="w-full text-left bg-white">
                 <thead class="bg-[#3C4F35] text-[#f0e6d2]">
                   <tr>
                     <th class="p-4 font-serif font-bold text-sm">TAMAÑO</th>
                     <th class="p-4 font-serif font-bold text-sm border-l border-white/10 text-center">BAJA</th>
                     <th class="p-4 font-serif font-bold text-sm border-l border-white/10 text-center">ALTA</th>
                   </tr>
                 </thead>
                 <tbody class="divide-y divide-gray-100 text-sm">
                   <tr>
                     <td class="p-4 font-medium">Chica <span class="text-xs text-gray-400 block font-normal">0 - 15 kg</span></td>
                     <td class="p-4 font-bold text-center text-[#3C4F35] border-l border-gray-100 bg-gray-50/50">$280</td>
                     <td class="p-4 font-bold text-center text-[#3C4F35] border-l border-gray-100 bg-gray-50/50">$380</td>
                   </tr>
                   <tr>
                     <td class="p-4 font-medium">Mediana <span class="text-xs text-gray-400 block font-normal">15 - 25 kg</span></td>
                     <td class="p-4 font-bold text-center text-[#3C4F35] border-l border-gray-100 bg-gray-50/50">$350</td>
                     <td class="p-4 font-bold text-center text-[#3C4F35] border-l border-gray-100 bg-gray-50/50">$450</td>
                   </tr>
                   <tr>
                     <td class="p-4 font-medium">Grande <span class="text-xs text-gray-400 block font-normal">25 - 50 kg</span></td>
                     <td class="p-4 font-bold text-center text-[#3C4F35] border-l border-gray-100 bg-gray-50/50">$430</td>
                     <td class="p-4 font-bold text-center text-[#3C4F35] border-l border-gray-100 bg-gray-50/50">$500</td>
                   </tr>
                   <tr>
                     <td class="p-4 font-medium bg-[#f0e6d2]/30">Ext. Grande <span class="text-xs text-gray-500 block font-normal">+50 kg</span></td>
                     <td class="p-4 font-bold text-center text-[#3C4F35] border-l border-white bg-[#f0e6d2]/30">$520</td>
                     <td class="p-4 font-bold text-center text-[#3C4F35] border-l border-white bg-[#f0e6d2]/30">$620</td>
                   </tr>
                 </tbody>
               </table>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
              <div class="border border-[#3C4F35]/10 p-5 rounded-2xl">
                 <strong class="block font-serif text-[#3C4F35] mb-2 border-b pb-2">Reglas de Reloj</strong>
                 <p class="text-sm text-gray-600 mb-1"><strong>Check-in:</strong> 11am - 7pm</p>
                 <p class="text-sm text-gray-600"><strong>Check-out:</strong> 10am - 2pm</p>
                 <span class="text-xs text-red-700/80 block mt-2 bg-red-50 p-2 rounded-lg italic">Costo de $100 extra fuera de tiempo.</span>
              </div>
              <div class="border border-[#3C4F35]/10 p-5 rounded-2xl">
                 <strong class="block font-serif text-[#3C4F35] mb-2 border-b pb-2">Requisitos Mágicos</strong>
                 <ul class="text-xs text-gray-600 space-y-1 list-none pl-0">
                    <li class="pl-3 relative before:content-[''] before:absolute before:left-0 before:top-2 before:w-1 before:h-1 before:bg-[#d2a265] before:rounded-full">Cartilla al corriente (Séxtuple, Giardia, Bordatella, Rabia).</li>
                    <li class="pl-3 relative before:content-[''] before:absolute before:left-0 before:top-2 before:w-1 before:h-1 before:bg-[#d2a265] before:rounded-full">Bravecto y Desparasitación int.</li>
                    <li class="pl-3 relative before:content-[''] before:absolute before:left-0 before:top-2 before:w-1 before:h-1 before:bg-[#d2a265] before:rounded-full">Traer alimento.</li>
                 </ul>
              </div>
            </div>
            <p class="text-[11px] text-center mt-6 text-gray-400 font-medium tracking-wide">*(Estancias de +6 noches se cobra baño de regalo obligatorio)*</p>
          </Fragment>
        </ServiceCardModal>

        <!-- 5. GROOMING & SPA -->
        <ServiceCardModal 
          id="grooming" 
          title="Spa & Baño" 
          subtitle="La Estrella - Grooming"
          colorTheme="light"
          imgSrc="/images/tarot/grooming.png"
        >
          
          <Fragment slot="content">
            <h3 class="text-3xl font-serif font-bold text-[#3C4F35] mb-6">Grooming Integral & Spa</h3>
            
            <div class="bg-gray-50 border border-gray-100 rounded-2xl p-6 mb-6">
              <div class="flex items-center justify-between border-b pb-2 mb-4">
                 <strong class="font-serif text-[#3C4F35]">Baño Premium</strong>
                 <span class="text-xs text-gray-400 italic">Pelo corto / Pelo largo</span>
              </div>
              <ul class="text-sm text-gray-700 space-y-4">
                 <li class="flex justify-between items-center bg-white p-3 rounded-lg border border-gray-100 shadow-sm"><span class="font-bold">Raza chica</span> <strong class="text-[#3C4F35] font-serif text-lg">$150 / $200</strong></li>
                 <li class="flex justify-between items-center bg-white p-3 rounded-lg border border-gray-100 shadow-sm"><span class="font-bold">Raza mediana</span> <strong class="text-[#3C4F35] font-serif text-lg">$250 / $350</strong></li>
                 <li class="flex justify-between items-center bg-white p-3 rounded-lg border border-gray-100 shadow-sm"><span class="font-bold">Raza grande</span> <strong class="text-[#3C4F35] font-serif text-lg">$400 / $450</strong></li>
              </ul>
            </div>

            <div class="grid grid-cols-2 gap-4">
               <div class="p-4 border border-[#3C4F35]/10 rounded-xl">
                  <strong class="block font-serif text-[#3C4F35] mb-2 border-b pb-1">Corte & Extras</strong>
                  <ul class="text-sm space-y-2 text-gray-600">
                     <li class="flex justify-between"><span>Corte tijera</span> <strong>desde $100</strong></li>
                     <li class="flex justify-between"><span>Corte uñas</span> <strong>$100</strong></li>
                     <li class="flex justify-between"><span>Corte higiénico</span> <strong>$100</strong></li>
                  </ul>
               </div>
               <div class="p-4 border border-[#3C4F35]/10 rounded-xl bg-gray-50">
                  <strong class="block font-serif text-[#3C4F35] mb-2 border-b pb-1">Tratamientos</strong>
                  <ul class="text-sm space-y-2 text-gray-600">
                     <li class="flex justify-between"><span>Lavado Dental</span> <strong>$100</strong></li>
                     <li class="flex justify-between"><span>Deslanado Ext.</span> <strong>$100</strong></li>
                  </ul>
               </div>
            </div>
          </Fragment>
        </ServiceCardModal>

        <!-- 6. CLINICA / SALUD -->
        <ServiceCardModal 
          id="health" 
          title="Salud & Mente" 
          subtitle="El Mundo - Adiestramiento y Clínico"
          colorTheme="gold"
          imgSrc="/images/tarot/health.png"
        >
          
          <Fragment slot="content">
            <h3 class="text-3xl font-serif font-bold text-[#3C4F35] mb-2">Adiestramiento & Protección</h3>
            <p class="text-gray-600 mb-8">El balance perfecto entre una mente educada y un cuerpo inmune y protegido contra amenazas.</p>

            <div class="space-y-6">
               
               <!-- Adiestramiento -->
               <div class="border-2 border-[#d2a265]/30 rounded-2xl overflow-hidden shadow-sm">
                  <div class="bg-[#d2a265]/10 p-3 border-b border-[#d2a265]/30">
                     <strong class="font-serif text-[#3C4F35] text-lg flex items-center gap-2">
                        Módulos de Adiestramiento
                     </strong>
                  </div>
                  <div class="p-5 bg-white">
                     <div class="grid grid-cols-2 gap-4">
                        <div class="text-center p-3 border border-gray-100 rounded-xl bg-gray-50">
                           <span class="block text-sm font-bold opacity-70 mb-1">BÁSICO / EN CASA</span>
                           <strong class="font-serif text-[#3C4F35] text-xl">$3,500 <span class="text-xs font-sans">/mód.</span></strong>
                        </div>
                        <div class="text-center p-3 border border-gray-100 rounded-xl bg-gray-50">
                           <span class="block text-sm font-bold opacity-70 mb-1">AVANZADO</span>
                           <strong class="font-serif text-[#3C4F35] text-xl">$4,000 <span class="text-xs font-sans">/mód.</span></strong>
                        </div>
                     </div>
                  </div>
               </div>

               <!-- Clínico -->
               <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <!-- Vacunas -->
                  <div class="bg-white border rounded-xl p-4 shadow-sm">
                     <strong class="block font-serif text-[#3C4F35] border-b pb-2 mb-3">Vacunas Inmunes</strong>
                     <ul class="text-sm space-y-2 text-gray-600">
                        <li class="flex justify-between items-center"><span class="leading-tight">Séxtuple, Bordatella o Rabia</span> <strong class="text-[#3C4F35]">$350<span class="text-[10px] opacity-70">c/u</span></strong></li>
                        <li class="flex justify-between items-center pt-1 border-t border-gray-50"><span class="leading-tight">Giardia</span> <strong class="text-[#3C4F35]">$430</strong></li>
                     </ul>
                  </div>

                  <!-- Bravecto -->
                  <div class="bg-gray-50 border rounded-xl p-4 shadow-sm">
                     <strong class="block font-serif text-[#3C4F35] border-b pb-2 mb-3">Protección Bravecto</strong>
