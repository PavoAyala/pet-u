---
// src/components/BookingSelector.astro
---

<div class="inline-block booking-selector-container">
    <!-- Main Button -->
    <button 
      type="button"
      class="main-booking-btn bg-[#3C4F35] shadow-lg hover:bg-[#2A3825] text-white px-10 py-3.5 rounded-full font-bold transition-all duration-300 flex items-center gap-3 group"
    >
      <span>Agendar cita</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:rotate-12 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12h14"/>
      </svg>
    </button>
</div>

<!-- Modal de Selección de Servicio (Pop-up Central) -->
<dialog id="serviceSelectorModal" class="p-0 rounded-[40px] backdrop:bg-[#3C4F35]/60 backdrop:backdrop-blur-sm shadow-2xl w-[90%] max-w-lg mx-auto overflow-hidden text-[#3C4F35] font-sans border-0 border-white/20 bg-transparent">
    <div class="bg-white/95 backdrop-blur-md p-8 md:p-10 relative">
        <!-- Close button inside modal -->
        <button id="closeSelector" class="absolute top-6 right-6 text-gray-400 hover:text-[#3C4F35] transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M6 18L18 6M6 6l12 12" /></svg>
        </button>

        <div class="text-center mb-8">
            <p class="text-[10px] font-bold text-[#d2a265] uppercase tracking-[0.2em] mb-2">Comienza la aventura</p>
            <h2 class="text-3xl font-serif font-bold mb-1 text-[#3C4F35]">¿Qué agendamos hoy?</h2>
            <p class="text-sm text-gray-500 max-w-[280px] mx-auto">Selecciona el servicio que deseas reservar para tu mejor amigo.</p>
        </div>

        <div class="grid grid-cols-1 gap-4">
            <!-- Hotel -->
            <button data-service="hotel" class="service-opt flex items-center gap-5 p-5 rounded-3xl border border-gray-100 bg-gray-50/50 hover:bg-white hover:border-[#d2a265] hover:shadow-xl hover:shadow-[#d2a265]/10 text-left transition-all group scale-100 active:scale-95">
                <div class="w-14 h-14 bg-amber-100 rounded-2xl flex items-center justify-center text-amber-600 shrink-0 group-hover:bg-amber-500 group-hover:text-white transition-all duration-300">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
                <div class="flex-1">
                    <p class="font-bold text-lg leading-none mb-1">Hotel Hogar</p>
                    <p class="text-xs text-gray-400">Estancias nocturnas y cuidado 24/7</p>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-[#d2a265] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>

            <!-- Daycare -->
            <button data-service="daycare" class="service-opt flex items-center gap-5 p-5 rounded-3xl border border-gray-100 bg-gray-50/50 hover:bg-white hover:border-[#3C4F35] hover:shadow-xl hover:shadow-[#3C4F35]/10 text-left transition-all group scale-100 active:scale-95">
                <div class="w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center text-emerald-600 shrink-0 group-hover:bg-[#3C4F35] group-hover:text-white transition-all duration-300">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div class="flex-1">
                    <p class="font-bold text-lg leading-none mb-1">Daycare (Fun Day)</p>
                    <p class="text-xs text-gray-400">Guardería, juegos y socialización</p>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-[#3C4F35] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>

            <!-- Spa / Clinic Grid -->
            <div class="grid grid-cols-2 gap-4">
                <button data-service="spa" class="service-opt p-5 rounded-3xl border border-gray-100 bg-gray-50/50 hover:bg-white hover:border-blue-500 hover:shadow-xl hover:shadow-blue-500/10 text-center transition-all group scale-100 active:scale-95">
                    <div class="w-12 h-12 bg-blue-100 rounded-2xl flex items-center justify-center text-blue-600 mx-auto mb-3 group-hover:bg-blue-500 group-hover:text-white transition-all duration-300">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                    </div>
                    <p class="font-bold text-sm leading-tight">Spa & Estética</p>
                </button>
                
                <button data-service="vacunas" class="service-opt p-5 rounded-3xl border border-gray-100 bg-gray-50/50 hover:bg-white hover:border-rose-500 hover:shadow-xl hover:shadow-rose-500/10 text-center transition-all group scale-100 active:scale-95">
                    <div class="w-12 h-12 bg-rose-100 rounded-2xl flex items-center justify-center text-rose-600 mx-auto mb-3 group-hover:bg-rose-500 group-hover:text-white transition-all duration-300">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <p class="font-bold text-sm leading-tight">Salud & Vacunas</p>
                </button>
            </div>
        </div>

        <p class="text-[10px] text-center mt-8 text-gray-400 font-medium uppercase tracking-widest leading-none">Miembro de la familia PET-U</p>
    </div>
</dialog>

<script>
    function setupBookingModal() {
        const modal = document.getElementById('serviceSelectorModal') as HTMLDialogElement;
        const triggerBtns = document.querySelectorAll('.main-booking-btn');
        const closeBtn = document.getElementById('closeSelector');
        const options = document.querySelectorAll('.service-opt');

        if (!modal) return;

        triggerBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                modal.showModal();
                document.body.style.overflow = 'hidden';
            });
        });

        closeBtn?.addEventListener('click', () => {
            modal.close();
            document.body.style.overflow = '';
        });

        // Close on click outside (backdrop)
        modal.addEventListener('click', (e) => {
            const rect = modal.getBoundingClientRect();
            const isInModal = (
                rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
                rect.left <= e.clientX && e.clientX <= rect.left + rect.width
            );
            if (!isInModal) {
                modal.close();
                document.body.style.overflow = '';
            }
        });

        options.forEach(opt => {
            opt.addEventListener('click', (e) => {
                const service = (e.currentTarget as HTMLElement).getAttribute('data-service');
                modal.close();
                document.body.style.overflow = '';

                // Dispatch event to open the dynamic BookingFormModal
                window.dispatchEvent(new CustomEvent('openBookingModal', { 
                    detail: { service } 
                }));
            });
        });
    }

    setupBookingModal();
    document.addEventListener('astro:page-load', setupBookingModal);
</script>

<style>
    dialog::backdrop {
        background: rgba(45, 59, 40, 0.4);
        backdrop-filter: blur(8px);
    }
    dialog[open] {
        animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>
