---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  iconPath?: string;
  imgSrc?: string;
  colorTheme?: 'dark' | 'light' | 'gold';
}

const { id, title, subtitle, iconPath, imgSrc, colorTheme = 'dark' } = Astro.props;

const themeStyles = {
  dark: {
    cardBg: 'bg-[#3C4F35]',
    cardText: 'text-[#f0e6d2]',
    borderColor: 'border-[#f0e6d2]/30',
    hoverBorder: 'hover:border-[#d2a265]',
  },
  light: {
    cardBg: 'bg-[#f0e6d2]',
    cardText: 'text-[#3C4F35]',
    borderColor: 'border-[#3C4F35]/30',
    hoverBorder: 'hover:border-[#3C4F35]',
  },
  gold: {
    cardBg: 'bg-gradient-to-br from-[#f8efe0] to-[#d2a265]',
    cardText: 'text-[#3C4F35]',
    borderColor: 'border-[#3C4F35]/20',
    hoverBorder: 'hover:border-[#3C4F35]/60',
  }
};

const currentTheme = themeStyles[colorTheme];
---

<!-- TARJETA (Gatillo del Modal) -->
<button 
  onclick={`document.getElementById('modal-${id}').showModal()`}
  class={`relative group w-full aspect-[2/3] max-w-sm mx-auto rounded-xl ${currentTheme.cardBg} ${currentTheme.cardText} p-6 flex flex-col items-center justify-between border-[6px] ${currentTheme.borderColor} ${currentTheme.hoverBorder} transition-all duration-500 hover:-translate-y-4 hover:shadow-[0_20px_40px_rgba(60,79,53,0.3)] overflow-hidden text-left focus:outline-none focus:ring-4 focus:ring-[#d2a265]/50`}
>
  <!-- Decoración Esquinas -->
  <div class="absolute top-2 left-2 w-4 h-4 border-t-2 border-l-2 border-current opacity-50"></div>
  <div class="absolute top-2 right-2 w-4 h-4 border-t-2 border-r-2 border-current opacity-50"></div>
  <div class="absolute bottom-2 left-2 w-4 h-4 border-b-2 border-l-2 border-current opacity-50"></div>
  <div class="absolute bottom-2 right-2 w-4 h-4 border-b-2 border-r-2 border-current opacity-50"></div>

  <!-- Contenido Frontal -->
  <div class="text-center mt-4 w-full flex flex-col items-center">
    <div class="w-[90%] aspect-square mx-auto mb-6 group-hover:scale-105 group-hover:-translate-y-2 transition-all duration-500 rounded-xl flex items-center justify-center shadow-[0_8px_30px_rgba(0,0,0,0.12)] border-2 border-current/20 bg-white/5 overflow-hidden">
      {imgSrc ? (
         <img src={imgSrc} alt={`Ilustración para ${title}`} class="w-full h-full object-cover mix-blend-multiply" />
      ) : (
         <div class="w-24 h-24 mx-auto opacity-80">
            <slot name="icon">
              {iconPath && (
                 <svg class="w-full h-full" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                   <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                   <path d={iconPath}></path>
                 </svg>
              )}
            </slot>
         </div>
      )}
    </div>
    <h3 class="font-serif text-[28px] md:text-3xl font-bold tracking-tight mb-2 leading-tight px-2">{title}</h3>
    {subtitle && <p class="font-sans text-[11px] md:text-sm uppercase tracking-widest opacity-80 px-2">{subtitle}</p>}
  </div>

  <!-- Indicador -->
  <div class="mb-4 text-xs tracking-widest uppercase opacity-60 group-hover:opacity-100 transition-opacity">
    <span class="border-b border-current pb-1">Ver detalles</span>
  </div>
</button>

<!-- MODAL (Nativo HTML tag <dialog>) -->
<dialog 
  id={`modal-${id}`} 
  class="backdrop:bg-[#2A3825]/80 backdrop:backdrop-blur-sm bg-transparent w-full max-w-2xl p-0 rounded-3xl m-auto shadow-2xl open:animate-in open:zoom-in-95 open:fade-in-10 closed:animate-out closed:zoom-out-95 closed:fade-out-0 duration-300"
>
  <div class="bg-[#fcfbf9] w-full rounded-3xl overflow-hidden relative flex flex-col min-h-[500px]">
    
    <!-- Botón Cerrar Absoluto -->
    <form method="dialog" class="absolute top-4 right-4 z-50">
      <button class="w-10 h-10 bg-white/50 backdrop-blur-md rounded-full flex items-center justify-center text-[#3C4F35] hover:bg-[#3C4F35] hover:text-white transition-colors border border-[#3C4F35]/10 shadow-sm" aria-label="Cerrar modal">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M18 6l-12 12" /><path d="M6 6l12 12" /></svg>
      </button>
    </form>

    <!-- Contenido Inyectado -->
    <div class="w-full p-8 md:p-12 overflow-y-auto max-h-[80vh] md:max-h-[90vh] text-[#3C4F35]">
      <!-- Header -->
      <div class="border-b border-[#3C4F35]/10 pb-4 mb-6 pr-12">
        <h2 class="font-serif text-3xl md:text-4xl font-bold">{title}</h2>
        {subtitle && <p class="text-sm md:text-base font-serif italic opacity-70 mt-2">{subtitle}</p>}
      </div>

      <!-- Slot para el contenido principal (Precios, Info) -->
      <slot name="content" />

      <!-- Botón de CTA Generalizado (Reemplazable) -->
      <div class="mt-8 pt-6 border-t border-[#3C4F35]/10 flex justify-end">
        <slot name="cta">
           <a href="https://wa.me/528145493733" target="_blank" class="inline-block flex-grow md:flex-grow-0 text-center bg-[#3C4F35] text-white py-3 px-8 rounded-full font-bold hover:bg-[#2A3825] shadow-md hover:shadow-lg transition-all border-2 border-[#3C4F35]">Solicitar Info</a>
        </slot>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Fix para que los modales dialog nativos se comporten suave */
  dialog::backdrop {
    animation: fade-in 0.3s ease-out;
  }
  dialog[open] {
    animation: zoom-in 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  
  @keyframes fade-in {
    0% { opacity: 0; backdrop-filter: blur(0px); }
    100% { opacity: 1; backdrop-filter: blur(4px); }
  }
  
  @keyframes zoom-in {
    0% { transform: scale(0.95); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
</style>
