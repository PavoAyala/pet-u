<script>
  import { functions, httpsCallable } from '@pet-u/firebase-config';
  import { loadGoogleMaps, initPlaceAutocomplete } from '../utils/googleMaps';
  import { userStore, type PetData, type UserProfile } from '../utils/userStore';
  import { initAuth } from '../utils/authIntegration';
  initAuth();

  async function loadGoogleMapsPlaces() {
    loadGoogleMaps(import.meta.env.PUBLIC_GOOGLE_MAPS_KEY);

    await initPlaceAutocomplete({
      containerId: 'happyBusAddressContainer',
      colorScheme: 'LIGHT',
      includedRegionCodes: ['mx'],
      onSelect: (location, address) => {
        (document.getElementById('happyBusLat') as HTMLInputElement).value = location.lat.toString();
        (document.getElementById('happyBusLng') as HTMLInputElement).value = location.lng.toString();
        (document.getElementById('happyBusAddressText') as HTMLInputElement).value = address;
        document.getElementById('addressError')?.classList.add('hidden');
        document.getElementById('happyBusAddressContainer')?.querySelector('*')?.removeAttribute('data-error');
      }
    });
  }

  type PriceLevel = Record<string, number>;

  type PricesMap = {
    hotel: {
      baja: PriceLevel;
      alta: PriceLevel;
    };
    daycare: PriceLevel;
    spa: PriceLevel;
    vacunas: {
      fixed: number;
    };
    [key: string]: PriceLevel | { fixed: number } | { baja: PriceLevel; alta: PriceLevel } | undefined;
  };

  const prices: PricesMap = {
    hotel: {
      baja: { chica: 280, mediana: 350, grande: 430, xl: 520 },
      alta: { chica: 380, mediana: 450, grande: 500, xl: 620 }
    },
    daycare: { chica: 180, mediana: 220, grande: 280, xl: 350 },
    spa: { chica: 350, mediana: 450, grande: 550, xl: 650 },
    vacunas: { fixed: 560 }
  };

  const mandatoryBathPrices: PriceLevel = {
    // Public grooming pricing is published by size, but the form does not capture coat type yet.
    // If coat type is added later, split this map into short/long hair pricing.
    chica: 150,
    mediana: 250,
    grande: 400,
    xl: 450
  };

  const transportPrices: Record<string, number> = {
    A: 100,
    B: 150,
    C: 200
  };

  const happyBusSchedules: Record<string, string> = {
    daycare: '<div class="space-y-1"><p><span class="text-sm font-black text-[#3C4F35] uppercase">Recolección:</span> <span class="text-base font-black text-[#3C4F35]">8:15 AM - 10:30 AM</span></p><p><span class="text-sm font-black text-[#3C4F35] uppercase">Entrega:</span> <span class="text-base font-black text-[#3C4F35]">4:30 PM - 6:00 PM</span></p></div>',
    spa: '<p><span class="text-sm font-black text-[#3C4F35] uppercase">Recolección y regreso:</span> <br/><span class="text-base font-black text-[#3C4F35]">a partir de las 11:00 AM</span></p>',
    hotel: '<p><span class="text-sm font-black text-[#3C4F35] uppercase">Recolección:</span> <span class="text-lg font-black text-[#3C4F35]">4:30 PM</span></p>',
    vacunas: 'Servicio a domicilio no disponible para vacunas.'
  };

  interface ServiceConfig {
    title: string;
    subtitle: string;
    checkinLabel: string;
    timeLabel: string;
    showCheckout: boolean;
    showSize: boolean;
    showVaccines: boolean;
    showHappyBus: boolean;
    showTimeSelection: boolean;
    showHotelTimeSelection: boolean;
    summaryPrefix: string;
  }

  const serviceConfigs: Record<string, ServiceConfig> = {
    hotel: { title: 'Reservar Hotel', subtitle: 'ESTANCIA NOCTURNA PREMIUM', checkinLabel: 'Llegada', timeLabel: 'Hora de llegada', showCheckout: true, showSize: true, showVaccines: false, showHappyBus: true, showTimeSelection: false, showHotelTimeSelection: true, summaryPrefix: 'Hospedaje:' },
    daycare: { title: 'Agendar Daycare', subtitle: 'SOCIALIZACIÓN Y DIVERSIÓN', checkinLabel: 'Fecha visita', timeLabel: 'Hora de llegada', showCheckout: false, showSize: true, showVaccines: false, showHappyBus: true, showTimeSelection: true, showHotelTimeSelection: false, summaryPrefix: 'Estancia:' },
    spa: { title: 'Cita de Grooming', subtitle: 'SPA & ESTÉTICA', checkinLabel: 'Fecha cita', timeLabel: 'Hora de cita', showCheckout: false, showSize: true, showVaccines: false, showHappyBus: true, showTimeSelection: true, showHotelTimeSelection: false, summaryPrefix: 'Servicio Spa:' },
    vacunas: { title: 'Vacunación', subtitle: 'SALUD Y PREVENCIÓN', checkinLabel: 'Fecha cita', timeLabel: 'Hora de cita', showCheckout: false, showSize: false, showVaccines: true, showHappyBus: false, showTimeSelection: true, showHotelTimeSelection: false, summaryPrefix: 'Vacuna:' }
  };

  const normalizeHappyBusAddress = (value: string | null | undefined) => {
    const normalized = value?.trim();
    if (!normalized) return null;
    if (normalized.toLowerCase() === 'n/a') return null;
    return normalized;
  };

  const availabilityCallable = httpsCallable(functions, 'booking-getAvailability');
  const createReservationCallable = httpsCallable(functions, 'booking-createReservation');

  const getTomorrowDateValue = () => {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Monterrey',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());

    const year = Number(parts.find((part) => part.type === 'year')?.value);
    const month = Number(parts.find((part) => part.type === 'month')?.value);
    const day = Number(parts.find((part) => part.type === 'day')?.value);
    const tomorrow = new Date(Date.UTC(year, month - 1, day));
    tomorrow.setUTCDate(tomorrow.getUTCDate() + 1);
    return tomorrow.toISOString().slice(0, 10);
  };

  const formatSlotLabel = (time: string) => {
    const [hourString, minuteString] = time.split(':');
    const hour = Number(hourString);
    const minute = Number(minuteString);
    const suffix = hour >= 12 ? 'PM' : 'AM';
    const normalizedHour = hour % 12 || 12;
    return `${normalizedHour}:${String(minute).padStart(2, '0')} ${suffix}`;
  };

  const generateTimeOptions = (startHour: number, endHour: number) => {
    const values: string[] = [];
    const current = new Date(Date.UTC(2000, 0, 1, startHour, 0));
    const end = new Date(Date.UTC(2000, 0, 1, endHour, 0));
    while (current <= end) {
      const hour = String(current.getUTCHours()).padStart(2, '0');
      const minute = String(current.getUTCMinutes()).padStart(2, '0');
      values.push(`${hour}:${minute}`);
      current.setUTCMinutes(current.getUTCMinutes() + 30);
    }
    return values;
  };

  function setupBookingForm() {
    const modal = document.getElementById('bookingModal') as HTMLDialogElement;
    const form = document.getElementById('bookingForm') as HTMLFormElement & { _bookingInit?: boolean };
    if (!modal || !form) return;
    if (form._bookingInit) return;
    form._bookingInit = true;

    const serviceTypeInput = document.getElementById('serviceTypeInput') as HTMLInputElement;
    const checkinInput = document.getElementById('checkinDate') as HTMLInputElement;
    const checkoutInput = document.getElementById('checkoutDate') as HTMLInputElement;
    const wantHappyBus = document.getElementById('wantHappyBus') as HTMLInputElement;
    const happyBusZone = document.getElementById('happyBusZone') as HTMLSelectElement;
    const summaryTotal = document.getElementById('summaryTotal');
    const mandatoryBathRow = document.getElementById('mandatoryBathRow');
    const hotelTimeSection = document.getElementById('hotelTimeSection')!;
    const hotelCheckinTime = document.getElementById('hotelCheckinTime') as HTMLSelectElement;
    const hotelCheckoutTime = document.getElementById('hotelCheckoutTime') as HTMLSelectElement;
    const timeSlotSection = document.getElementById('timeSlotSection')!;
    const timeSlotLabel = document.getElementById('timeSlotLabel')!;
    const timeSlotBadge = document.getElementById('timeSlotBadge')!;
    const timeSlotGrid = document.getElementById('timeSlotGrid')!;
    const timeSlotStatus = document.getElementById('timeSlotStatus')!;
    const appointmentTimeInput = document.getElementById('appointmentTime') as HTMLInputElement;

    // Pet Selector Elements
    const authPetSelectorGroup = document.getElementById('authPetSelectorGroup')!;
    const authPetSelector = document.getElementById('authPetSelector') as HTMLSelectElement;
    const ownerNameInput = document.getElementById('ownerName') as HTMLInputElement;
    const petNameInput = document.getElementById('petName') as HTMLInputElement;

    const populateUserData = () => {
      const state = userStore.get();
      const profile = state.profile as UserProfile | null;
      
      // Autocompletar nombre del dueño
      if (!ownerNameInput.value || ownerNameInput.value === '' || ownerNameInput.value === 'Mi Perfil' || ownerNameInput.value === 'Ej. Juan Pérez') {
        if (profile?.displayName) {
          ownerNameInput.value = profile.displayName;
        } else if (state.user?.displayName) {
          ownerNameInput.value = state.user.displayName;
        } else if (state.user?.email) {
          ownerNameInput.value = state.user.email.split('@')[0];
        }
      }

      if (profile?.address) {
        const addressInput = document.getElementById('happyBusAddress') as HTMLInputElement;
        if (addressInput && (!addressInput.value || addressInput.value === '')) {
          addressInput.value = profile.address;
          // Si el texto de la dirección está presente, también lo guardamos en el campo oculto
          const addressTextHidden = document.getElementById('happyBusAddressText') as HTMLInputElement;
          if (addressTextHidden) addressTextHidden.value = profile.address;

          if (profile.lat && profile.lng) {
            (document.getElementById('happyBusLat') as HTMLInputElement).value = profile.lat.toString();
            (document.getElementById('happyBusLng') as HTMLInputElement).value = profile.lng.toString();
          }
        }
      }
    };

    let localPets: PetData[] = [];
    userStore.subscribe((state) => {
      populateUserData();
      
      localPets = state.pets;
      if (localPets.length > 0) {
        authPetSelectorGroup.classList.remove('hidden');
        
        let targetOptions = `<option value="" disabled selected>Elegir de mi perfil...</option>`;
        localPets.forEach(pet => {
           targetOptions += `<option value="${pet.id}">${pet.name} (${pet.size})</option>`;
        });
        targetOptions += `<option value="new">+ Registrar manualmente</option>`;
        
        authPetSelector.innerHTML = targetOptions;
      } else {
        authPetSelectorGroup.classList.add('hidden');
      }
    });

    authPetSelector.addEventListener('change', () => {
       const selectedPet = localPets.find(p => p.id === authPetSelector.value);
       if (selectedPet) {
          petNameInput.value = selectedPet.name;
          populateUserData(); // También asegurar nombre del usuario al seleccionar mascota
          const radio = form.querySelector(`input[name="petSize"][value="${selectedPet.size}"]`) as HTMLInputElement;
          if (radio) {
             radio.checked = true;
             calculateTotal(); // update pricing
          }
       } else if (authPetSelector.value === 'new') {
          petNameInput.value = '';
          const checkedRadio = form.querySelector(`input[name="petSize"]:checked`) as HTMLInputElement;
          if (checkedRadio) checkedRadio.checked = false;
       }
    });

    let currentAvailabilityRequest = 0;
    let hotelInfoShownForCurrentOpen = false;

    const hotelCheckinOptions = generateTimeOptions(11, 19);
    const hotelCheckoutOptions = generateTimeOptions(10, 14);
    hotelCheckinTime.innerHTML = `<option value="" selected>Seleccionar...</option>${hotelCheckinOptions.map((time) => `<option value="${time}">${formatSlotLabel(time)}</option>`).join('')}`;
    hotelCheckoutTime.innerHTML = `<option value="" selected>Seleccionar...</option>${hotelCheckoutOptions.map((time) => `<option value="${time}">${formatSlotLabel(time)}</option>`).join('')}`;

    const resetTimeSelection = () => {
      appointmentTimeInput.value = '';
      timeSlotGrid.innerHTML = '';
      timeSlotStatus.classList.add('hidden', 'text-red-500', 'text-gray-400');
      timeSlotStatus.textContent = '';
      timeSlotBadge.classList.add('hidden');
      document.getElementById('timeSlotError')?.classList.add('hidden');
    };

    const resetHotelTimeSelection = () => {
      hotelCheckinTime.value = '';
      hotelCheckoutTime.value = '';
      document.getElementById('hotelTimeError')?.classList.add('hidden');
    };

    const setTimeSlotStatus = (message: string, tone: 'neutral' | 'error' = 'neutral') => {
      timeSlotStatus.classList.remove('hidden', 'text-red-500', 'text-gray-400');
      timeSlotStatus.classList.add(tone === 'error' ? 'text-red-500' : 'text-gray-400');
      timeSlotStatus.textContent = message;
    };

    const updateDateMinimums = () => {
      const minDate = getTomorrowDateValue();
      checkinInput.min = minDate;
      checkoutInput.min = checkinInput.value || minDate;
    };

    const shouldShowTimeSelection = () => {
      const config = serviceConfigs[serviceTypeInput.value];
      return Boolean(config?.showTimeSelection && !wantHappyBus.checked);
    };

    const updateTimeSelectionVisibility = () => {
      if (shouldShowTimeSelection()) {
        timeSlotSection.classList.remove('hidden');
      } else {
        timeSlotSection.classList.add('hidden');
        resetTimeSelection();
      }
    };

    const shouldShowHotelTimeSelection = () => {
      const config = serviceConfigs[serviceTypeInput.value];
      return Boolean(config?.showHotelTimeSelection && !wantHappyBus.checked);
    };

    const updateHotelTimeVisibility = () => {
      if (shouldShowHotelTimeSelection()) {
        hotelTimeSection.classList.remove('hidden');
      } else {
        hotelTimeSection.classList.add('hidden');
        resetHotelTimeSelection();
      }
    };

    const hotelInfoModal = document.getElementById('hotelInfoModal') as HTMLDialogElement | null;
    const maybeShowHotelInfo = () => {
      if (!hotelInfoModal) return;
      if (serviceTypeInput.value !== 'hotel' || wantHappyBus.checked || hotelInfoShownForCurrentOpen) return;
      hotelInfoModal.showModal();
      hotelInfoShownForCurrentOpen = true;
    };

    document.getElementById('closeHotelInfoModal')?.addEventListener('click', () => hotelInfoModal?.close());
    document.getElementById('confirmHotelInfoModal')?.addEventListener('click', () => hotelInfoModal?.close());

    const renderTimeSlots = (slots: Array<{ time: string; label?: string; available: boolean }>) => {
      timeSlotGrid.innerHTML = slots.map((slot) => `
        <button
          type="button"
          class="time-slot-btn px-3 py-2 rounded-xl border text-xs font-bold transition-all ${slot.available ? 'border-[#3C4F35]/15 bg-white text-[#3C4F35] hover:border-[#3C4F35] hover:bg-[#3C4F35]/5' : 'border-gray-100 bg-gray-50 text-gray-300 cursor-not-allowed'}"
          data-time="${slot.time}"
          ${slot.available ? '' : 'disabled'}
        >
          ${slot.label || formatSlotLabel(slot.time)}
        </button>
      `).join('');

      timeSlotGrid.querySelectorAll('.time-slot-btn:not([disabled])').forEach((button) => {
        button.addEventListener('click', () => {
          appointmentTimeInput.value = button.getAttribute('data-time') || '';
          document.getElementById('timeSlotError')?.classList.add('hidden');

          timeSlotGrid.querySelectorAll('.time-slot-btn').forEach((candidate) => {
            candidate.classList.remove('bg-[#3C4F35]', 'text-black', 'border-[#3C4F35]');
          });

          button.classList.add('bg-[#3C4F35]', 'text-black', 'border-[#3C4F35]');
        });
      });
    };

    const loadAvailability = async () => {
      updateTimeSelectionVisibility();
      updateHotelTimeVisibility();
      if (!shouldShowTimeSelection()) return;

      if (!checkinInput.value) {
        resetTimeSelection();
        setTimeSlotStatus('Selecciona una fecha para ver horarios disponibles.');
        return;
      }

      if (checkinInput.value < getTomorrowDateValue()) {
        resetTimeSelection();
        setTimeSlotStatus('Las reservaciones deben hacerse con al menos 1 día de anticipación.', 'error');
        return;
      }

      const requestId = ++currentAvailabilityRequest;
      resetTimeSelection();
      setTimeSlotStatus('Consultando horarios disponibles...');

      try {
        const response = await availabilityCallable({ date: checkinInput.value });
        if (requestId !== currentAvailabilityRequest) return;

        const data = response.data as {
          slots: Array<{ time: string; label?: string; available: boolean }>;
        };

        if (!data.slots.length) {
          setTimeSlotStatus('No hay horarios disponibles para esa fecha.', 'error');
          return;
        }

        const availableCount = data.slots.filter((slot) => slot.available).length;
        timeSlotBadge.classList.remove('hidden');
        timeSlotBadge.textContent = `${availableCount} disponibles`;

        if (availableCount === 0) {
          setTimeSlotStatus('Todos los horarios ya están ocupados para esa fecha.', 'error');
          renderTimeSlots(data.slots);
          return;
        }

        timeSlotStatus.classList.add('hidden');
        renderTimeSlots(data.slots);
      } catch {
        if (requestId !== currentAvailabilityRequest) return;
        setTimeSlotStatus('No fue posible cargar la disponibilidad. Intenta de nuevo.', 'error');
      }
    };

    const calculateTotal = () => {
      const service = serviceTypeInput.value;
      const sizeEl = form.querySelector('input[name="petSize"]:checked') as HTMLInputElement;
      const selectedSize = sizeEl?.value;

      let subtotal = 0;
      let mandatoryBath = 0;
      let transport = 0;

      if (service === 'hotel') {
        if (!selectedSize || !checkinInput.value || !checkoutInput.value) return;
        const [inY, inM, inD] = checkinInput.value.split('-').map(Number);
        const [outY, outM, outD] = checkoutInput.value.split('-').map(Number);
        const checkin = new Date(inY, inM - 1, inD);
        const checkout = new Date(outY, outM - 1, outD);
        const diffDays = Math.round((checkout.getTime() - checkin.getTime()) / (1000 * 60 * 60 * 24));

        if (diffDays <= 0) {
          document.getElementById('dateErrorMessage')?.classList.remove('hidden');
          checkinInput.value = '';
          checkoutInput.value = '';
          document.getElementById('priceSummary')?.classList.add('hidden');
          return;
        }

        document.getElementById('dateErrorMessage')?.classList.add('hidden');

        if (diffDays > 6) {
          mandatoryBath = mandatoryBathPrices[selectedSize] || 0;
        }

        const currentDate = new Date(checkin.getTime());
        for (let i = 0; i < diffDays; i++) {
          const month = currentDate.getMonth();
          const day = currentDate.getDate();
          const year = currentDate.getFullYear();
          const isHigh = (year === 2025 && month === 11) || (year === 2026 && month === 0 && day <= 7);
          const hotelPrices = prices.hotel[isHigh ? 'alta' : 'baja'];
          if (hotelPrices && selectedSize) {
            subtotal += (hotelPrices as PriceLevel)[selectedSize] || 0;
          }
          currentDate.setDate(currentDate.getDate() + 1);
        }
      } else if (service === 'vacunas') {
        subtotal = prices.vacunas.fixed || 0;
      } else {
        if (!selectedSize || !checkinInput.value) return;
        const servicePrice = prices[service];
        if (servicePrice && selectedSize) {
          subtotal = (servicePrice as PriceLevel)[selectedSize] || 0;
        }
      }

      if (wantHappyBus.checked && happyBusZone.value) {
        transport = transportPrices[happyBusZone.value] || 0;
        const transportRow = document.getElementById('transportRow');
        transportRow?.classList.remove('hidden');
        transportRow?.classList.add('flex');
        document.getElementById('transportValue')!.textContent = transport.toLocaleString();
      } else {
        const transportRow = document.getElementById('transportRow');
        transportRow?.classList.add('hidden');
        transportRow?.classList.remove('flex');
      }

      if (mandatoryBath > 0) {
        mandatoryBathRow?.classList.remove('hidden');
        mandatoryBathRow?.classList.add('flex');
        document.getElementById('mandatoryBathValue')!.textContent = mandatoryBath.toLocaleString();
      } else {
        mandatoryBathRow?.classList.add('hidden');
        mandatoryBathRow?.classList.remove('flex');
        document.getElementById('mandatoryBathValue')!.textContent = '0';
      }

      document.getElementById('subtotalValue')!.textContent = subtotal.toLocaleString();
      summaryTotal!.textContent = (subtotal + mandatoryBath + transport).toLocaleString();
      document.getElementById('priceSummary')?.classList.remove('hidden');
    };

    const openModal = (service: string) => {
      const config = serviceConfigs[service];
      if (!config) return;

      form.reset();
      populateUserData(); // Re-poblar datos del usuario después del reset
      serviceTypeInput.value = service;
      document.getElementById('modalTitle')!.textContent = config.title;
      document.getElementById('modalSubtitle')!.textContent = config.subtitle;
      document.getElementById('checkinLabel')!.textContent = config.checkinLabel;
      document.getElementById('summaryLabel')!.textContent = config.summaryPrefix;
      timeSlotLabel.textContent = config.timeLabel;

      document.getElementById('checkoutGroup')?.classList.toggle('hidden', !config.showCheckout);
      document.getElementById('sizeSelectionGroup')?.classList.toggle('hidden', !config.showSize);
      document.getElementById('vaccineSelectionGroup')?.classList.toggle('hidden', !config.showVaccines);
      document.getElementById('happyBusSection')?.classList.toggle('hidden', !config.showHappyBus);
      timeSlotSection.classList.toggle('hidden', !config.showTimeSelection);
      hotelTimeSection.classList.toggle('hidden', !config.showHotelTimeSelection);

      if (config.showVaccines) {
        (document.getElementById('vaccineType') as HTMLSelectElement).required = true;
      }

      wantHappyBus.checked = false;
      document.getElementById('happyBusOptions')?.classList.add('hidden');
      const hpSchedule = document.getElementById('happyBusSchedule');
      if (hpSchedule) hpSchedule.innerHTML = happyBusSchedules[service] || '';

      updateDateMinimums();
      resetTimeSelection();
      resetHotelTimeSelection();
      updateHotelTimeVisibility();
      hotelInfoShownForCurrentOpen = false;
      document.getElementById('priceSummary')?.classList.add('hidden');
      document.getElementById('formStatus')?.classList.add('hidden');

      modal.showModal();
      document.body.style.overflow = 'hidden';
      maybeShowHotelInfo();
    };

    window.addEventListener('openBookingModal', ((e: Event) => {
      const customEvent = e as CustomEvent;
      openModal(customEvent.detail.service);
    }) as EventListener);

    document.querySelectorAll('.openHotelBooking').forEach((btn) => {
      btn.addEventListener('click', () => openModal('hotel'));
    });

    form.querySelectorAll('input[name="petSize"]').forEach((radio) => radio.addEventListener('change', calculateTotal));
    updateDateMinimums();

    checkinInput.addEventListener('change', async () => {
      const config = serviceConfigs[serviceTypeInput.value];

      if (config?.showCheckout && checkinInput.value) {
        checkoutInput.min = checkinInput.value;

        if (checkoutInput.value && checkoutInput.value < checkinInput.value) {
          checkoutInput.value = '';
        }

        setTimeout(() => {
          if (typeof checkoutInput.showPicker === 'function') {
            checkoutInput.showPicker();
          } else {
            checkoutInput.focus();
          }
        }, 100);
      }

      calculateTotal();
      await loadAvailability();
    });

    checkoutInput.addEventListener('change', calculateTotal);
    wantHappyBus.addEventListener('change', async () => {
      document.getElementById('happyBusOptions')?.classList.toggle('hidden', !wantHappyBus.checked);
      if (wantHappyBus.checked) loadGoogleMapsPlaces();
      updateTimeSelectionVisibility();
      updateHotelTimeVisibility();
      if (!wantHappyBus.checked) maybeShowHotelInfo();
      await loadAvailability();
      calculateTotal();
    });
    happyBusZone.addEventListener('change', calculateTotal);

    document.getElementById('closeBookingModal')?.addEventListener('click', () => {
      modal.close();
      document.body.style.overflow = '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submitBooking') as HTMLButtonElement;
      const formStatus = document.getElementById('formStatus');
      const config = serviceConfigs[serviceTypeInput.value];

      if (wantHappyBus.checked) {
        let happyBusValid = true;

        const zone = happyBusZone.value;
        const lat = (document.getElementById('happyBusLat') as HTMLInputElement).value;
        const lng = (document.getElementById('happyBusLng') as HTMLInputElement).value;

        if (!zone) {
          document.getElementById('zoneError')?.classList.remove('hidden');
          happyBusValid = false;
        } else {
          document.getElementById('zoneError')?.classList.add('hidden');
        }

        if (!lat || !lng) {
          document.getElementById('addressError')?.classList.remove('hidden');
          const wrapper = document.getElementById('addressInputWrapper');
          wrapper?.classList.add('ring-2', 'ring-red-400', 'rounded-xl');
          setTimeout(() => wrapper?.classList.remove('ring-2', 'ring-red-400', 'rounded-xl'), 3000);
          happyBusValid = false;
        } else {
          document.getElementById('addressError')?.classList.add('hidden');
        }

        if (!happyBusValid) return;
      }

      if (shouldShowTimeSelection() && !appointmentTimeInput.value) {
        document.getElementById('timeSlotError')?.classList.remove('hidden');
        return;
      }

      if (shouldShowHotelTimeSelection() && (!hotelCheckinTime.value || !hotelCheckoutTime.value)) {
        document.getElementById('hotelTimeError')?.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';

      try {
        const sizeEl = form.querySelector('input[name="petSize"]:checked') as HTMLInputElement;
        const totalValue = parseInt(summaryTotal?.textContent?.replace(/,/g, '') || '0');
        const serviceType = serviceTypeInput.value;
        const happyBusAddress = normalizeHappyBusAddress(
          (document.getElementById('happyBusAddressText') as HTMLInputElement).value
        );
        const mandatoryBathCost = parseInt(document.getElementById('mandatoryBathValue')?.textContent?.replace(/,/g, '') || '0');

        const reservationData = {
          serviceType,
          petName: (document.getElementById('petName') as HTMLInputElement).value,
          ownerName: (document.getElementById('ownerName') as HTMLInputElement).value,
          petSize: sizeEl?.value || null,
          vaccineType: serviceType === 'vacunas' ? (document.getElementById('vaccineType') as HTMLSelectElement).value : null,
          happyBus: {
            want: wantHappyBus.checked,
            zone: wantHappyBus.checked ? happyBusZone.value : null,
            address: wantHappyBus.checked ? happyBusAddress : null,
            lat: wantHappyBus.checked ? parseFloat((document.getElementById('happyBusLat') as HTMLInputElement).value) || null : null,
            lng: wantHappyBus.checked ? parseFloat((document.getElementById('happyBusLng') as HTMLInputElement).value) || null : null,
            cost: wantHappyBus.checked ? (transportPrices[happyBusZone.value] || 0) : 0
          },
          checkin: checkinInput.value,
          checkout: serviceType === 'hotel' ? checkoutInput.value : checkinInput.value,
          appointmentTime: config.showTimeSelection && !wantHappyBus.checked ? appointmentTimeInput.value : null,
          checkinTime: serviceType === 'hotel' && !wantHappyBus.checked ? hotelCheckinTime.value : null,
          checkoutTime: serviceType === 'hotel' && !wantHappyBus.checked ? hotelCheckoutTime.value : null,
          mandatoryBathCost,
          totalEstimado: totalValue,
        };

        await createReservationCallable(reservationData);

        formStatus!.classList.remove('hidden');
        formStatus!.className = 'text-sm font-bold text-center p-4 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-100 mt-4';
        formStatus!.innerHTML = '¡Reserva enviada con éxito! 🐾';

        setTimeout(() => {
          modal.close();
          document.body.style.overflow = '';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Confirmar Reserva';
        }, 3000);
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Error desconocido';
        formStatus!.classList.remove('hidden');
        formStatus!.className = 'text-sm font-bold text-center p-3 rounded-lg bg-rose-50 text-rose-800 border border-rose-100 mt-4';
        formStatus!.textContent = 'Hubo un error: ' + message;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Intentar de nuevo';
      }
    });
  }

  document.addEventListener('astro:page-load', setupBookingForm);
  if (document.readyState !== 'loading') setupBookingForm();
</script>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }
  dialog[open] {
    animation: zoomIn 0.3s ease-out forwards;
  }
  @keyframes zoomIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #3C4F35; border-radius: 10px; }

  /* Estilos para el nuevo PlaceAutocompleteElement */
  gmp-place-autocomplete {
    width: 100%;
    display: block;
  }
  gmp-place-autocomplete::part(input) {
    width: 100%;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 0.5rem 0.75rem;
    padding-right: 2.5rem;
    font-size: 0.875rem;
    background-color: white;
    color: #374151;
    font-family: inherit;
    transition: all 0.2s;
  }
  gmp-place-autocomplete::part(input):focus {
    outline: none;
    border-color: transparent;
    box-shadow: 0 0 0 2px #3C4F35;
  }
  /* Asegurar que la lista de resultados sea visible */
  gmp-place-autocomplete::part(results-list) {
    background-color: white;
    z-index: 10000;
  }
  /* Ocultar el icono de pin en la barra de búsqueda */
  gmp-place-autocomplete::part(icon) {
    display: none;
  }
  .time-slot-btn[disabled] {
    opacity: 1;
  }
</style>
